<UserControl x:Class="AutoReportWizard.Step5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2D2D30">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="VsTab"
                TargetType="Border">
            <Setter Property="Background"
                    Value="#007ACC"/>
            <Setter Property="Padding"
                    Value="12,4"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
        </Style>
        <Style x:Key="VsTabText"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>
        <Style x:Key="HeaderTextBox"
                TargetType="TextBox">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="#E5E5E5"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="4"/>
            <Setter Property="Margin"
                    Value="0,2"/>
            <Setter Property="Foreground"
                    Value="#222222"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F5F5F5"
                BorderBrush="#CCC"
                BorderThickness="0,0,0,1"
                Padding="10">
            <StackPanel>
                <TextBlock Text="Report Parameters (SQL and RDLC)"
                           FontWeight="Bold"
                           Foreground="#333"
                           Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           Foreground="#333"
                                           FontSize="11"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SqlDataType, UpdateSourceTrigger=PropertyChanged}"
                                         Background="White"
                                         Foreground="#222"
                                         BorderBrush="#CCC"
                                         BorderThickness="1"
                                         Padding="4,2"
                                         FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
                Background="#1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource VsTab}">
                <TextBlock Text="Design Blueprint"
                        Style="{StaticResource VsTabText}"/>
            </Border>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Margin="20">
                <Border Background="White"
                        BorderBrush="#555"
                        BorderThickness="1"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        MinWidth="760"
                        MinHeight="440">
                    <StackPanel>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Static Header Text"
                                           Foreground="#777"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding StaticHeaderLeftLine1, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource HeaderTextBox}"
                                         FontWeight="Bold"
                                         FontSize="12"/>
                                <TextBox Text="{Binding StaticHeaderLeftLine2, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource HeaderTextBox}"
                                         FontWeight="Bold"
                                         FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        MinWidth="220">
                                <TextBlock Text="Report Header"
                                           Foreground="#777"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource HeaderTextBox}"
                                         FontWeight="Bold"
                                         FontSize="16"
                                         HorizontalAlignment="Stretch"
                                         TextAlignment="Center"/>
                                <TextBox Text="{Binding ReportSubtitle, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource HeaderTextBox}"
                                         FontSize="12"
                                         Foreground="#555"
                                         HorizontalAlignment="Stretch"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dynamic Header Binding"
                                           Foreground="#777"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Fields}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding DynamicHeaderFieldName, Mode=TwoWay}"
                                          Height="30"
                                          HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding CurrentPreviewTime, Mode=OneWay, StringFormat='Execution: {0}'}"
                                           HorizontalAlignment="Right"
                                           FontSize="12"
                                           Foreground="#555"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Dynamic Detail Layout"
                                   Foreground="#777"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <Border BorderBrush="#CCC"
                                BorderThickness="1">
                            <ListView x:Name="LayoutGrid"
                                      ItemsSource="{Binding Fields}"
                                      BorderThickness="0"
                                      Background="White"
                                      SelectionChanged="LayoutGrid_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="DATA FIELD"
                                                Width="180">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name, StringFormat='[{0}]'}"
                                                               Foreground="Black"
                                                               FontSize="11"
                                                               Padding="4"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="EXPRESSION MAPPING"
                                                Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name, StringFormat='=Fields!{0}.Value'}"
                                                               Foreground="Black"
                                                               FontWeight="Bold"
                                                               FontSize="11"
                                                               Padding="4"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="AGGREGATE"
                                                        DisplayMemberBinding="{Binding Aggregate}"
                                                        Width="100"/>

                                        <GridViewColumn Header="INCLUDE"
                                                Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsDetailField}"
                                                              HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                            <Button Content="Move Col Left"
                                    Background="#EEE"
                                    Foreground="#222"
                                    BorderBrush="#CCC"
                                    Padding="8,4"
                                    Margin="0,0,8,0"
                                    Click="MoveUp_Click"/>
                            <Button Content="Move Col Right"
                                    Background="#EEE"
                                    Foreground="#222"
                                    BorderBrush="#CCC"
                                    Padding="8,4"
                                    Click="MoveDown_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#3E3E42"
                        Padding="8,4">
                    <TextBlock Text="Row Groups"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Fields}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Margin="4,2"
                                        Visibility="{Binding IsGroupBy, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="[ "
                                           Foreground="#007ACC"
                                           FontSize="11"/>
                                <TextBlock Text="{Binding Name, StringFormat='({0})'}"
                                           Foreground="White"
                                           FontSize="11"/>
                                <TextBlock Text=" ]"
                                           Foreground="#007ACC"
                                           FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
