<UserControl x:Class="AutoReportWizard.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TransferBtn"
                TargetType="Button">
            <Setter Property="Background"
                    Value="#2A2A2A"/>
            <Setter Property="Foreground"
                    Value="#CCC"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Margin"
                    Value="0,4"/>
            <Setter Property="Padding"
                    Value="0,6"/>
            <Setter Property="BorderBrush"
                    Value="#444"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                Text="Dataset Definition"
                Foreground="White"
                FontSize="26"
                FontWeight="Bold"/>
        <TextBlock Grid.Row="1"
                Foreground="Gray"
                FontSize="13"
                Margin="0,5,0,20"
                   Text="Which fields do you want on your report? Select a database and table, then choose your fields."/>

        <Grid Grid.Row="2"
                Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                            Text="Database"
                            Foreground="#D4AF37"
                            FontWeight="SemiBold"
                            Margin="0,0,0,5"/>
                    <TextBlock Grid.Column="1"
                            Text="↻ Load"
                            Foreground="#007ACC"
                            Cursor="Hand"
                            MouseDown="RefreshDatabases_MouseDown"
                            FontSize="11"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,5"/>
                </Grid>
                <ComboBox ItemsSource="{Binding AvailableDatabases}"
                        SelectedItem="{Binding SelectedDatabase}"
                          Background="#1A1A1A"
                        Foreground="White"
                        BorderBrush="#444"
                        FontSize="13"
                        Height="30"
                          SelectionChanged="Database_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Schema"
                        Foreground="#D4AF37"
                        FontWeight="SemiBold"
                        Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding AvailableSchemas}"
                        SelectedItem="{Binding SelectedSchema}"
                          Background="#1A1A1A"
                        Foreground="White"
                        BorderBrush="#444"
                        FontSize="13"
                        Height="30"
                          SelectionChanged="Schema_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Tables / Queries"
                        Foreground="#D4AF37"
                        FontWeight="SemiBold"
                        Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding AvailableTables}"
                        SelectedItem="{Binding SelectedTable}"
                          Background="#1A1A1A"
                        Foreground="White"
                        BorderBrush="#444"
                        FontSize="13"
                        Height="30"
                          SelectionChanged="Table_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Available Fields:"
                        Foreground="#CCC"
                        Margin="0,0,0,5"/>
                <Border Background="#1A1A1A"
                        BorderBrush="#444"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ListBox x:Name="AvailableList"
                            ItemsSource="{Binding AvailableFields}"
                             Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            Height="300"
                            SelectionMode="Extended">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                        Margin="4,2">
                                    <TextBlock Text="{Binding SourceTable, StringFormat='[{0}].'}"
                                            Foreground="#777"
                                            FontSize="11"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                            Foreground="White"
                                            FontSize="13"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="10,0">
                <Button Content="&gt;"
                        Style="{StaticResource TransferBtn}"
                        Click="MoveRight_Click"/>
                <Button Content="&gt;&gt;"
                        Style="{StaticResource TransferBtn}"
                        Click="MoveAllRight_Click"/>
                <Button Content="&lt;"
                        Style="{StaticResource TransferBtn}"
                        Click="MoveLeft_Click"/>
                <Button Content="&lt;&lt;"
                        Style="{StaticResource TransferBtn}"
                        Click="MoveAllLeft_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Selected Fields:"
                        Foreground="#CCC"
                        Margin="0,0,0,5"/>
                <Border Background="#1A1A1A"
                        BorderBrush="#444"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ListBox x:Name="SelectedList"
                            ItemsSource="{Binding Fields}"
                             Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            Height="300"
                            SelectionMode="Extended">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                        Margin="4,2">
                                    <TextBlock Text="{Binding SourceTable, StringFormat='[{0}].'}"
                                            Foreground="#777"
                                            FontSize="11"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                            Foreground="White"
                                            FontSize="13"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>