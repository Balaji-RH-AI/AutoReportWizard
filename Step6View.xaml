<UserControl x:Class="AutoReportWizard.Step6View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoReportWizard"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="InvBool"/>

        <Style x:Key="GoldBtn" TargetType="Button">
            <Setter Property="Background" Value="#D4AF37"/>
            <Setter Property="Foreground" Value="#0A0A0A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B8962A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Preview and Generate"
                   Foreground="White"
                   FontSize="26"
                   FontWeight="Bold"/>
        <TextBlock Grid.Row="1"
                   Foreground="Gray"
                   FontSize="13"
                   Margin="0,5,0,16"
                   TextWrapping="Wrap"
                   Text="Enter stored procedure parameters, run a live preview, then generate the T-SQL and RDLC output files."/>

        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#111111"
                    BorderBrush="#333"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Stored Procedure Parameters"
                               Foreground="#D4AF37"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SqlDataType}"
                                                       Foreground="#777"
                                                       FontSize="10"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1A1A1A"
                                                 Foreground="White"
                                                 BorderBrush="#444"
                                                 Padding="8,5"
                                                 FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Text="{Binding PreviewError}"
                               Foreground="#FF7777"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,8"
                               Visibility="{Binding HasPreviewError, Converter={StaticResource BoolToVis}}"/>

                    <Button Grid.Row="3"
                            Content="Run Preview"
                            Style="{StaticResource GoldBtn}"
                            Command="{Binding RunPreviewCommand}"
                            IsEnabled="{Binding IsPreviewRunning, Converter={StaticResource InvBool}}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#0D1117"
                    BorderBrush="#333"
                    BorderThickness="1"
                    CornerRadius="6">
                <DataGrid ItemsSource="{Binding PreviewData.DefaultView}"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="#0D1117"
                          Foreground="#E6E6E6"
                          RowBackground="#111820"
                          AlternatingRowBackground="#0D1117"
                          BorderThickness="0"
                          ColumnHeaderHeight="30"
                          RowHeight="28"/>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Output Folder:"
                       Foreground="#D4AF37"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="1"
                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                     Background="#1A1A1A"
                     Foreground="White"
                     BorderBrush="#444"
                     Padding="8"
                     FontSize="12"
                     VerticalAlignment="Center"/>
            <Button Grid.Column="3"
                    Content="Browse..."
                    Style="{StaticResource DarkBtn}"
                    Click="BrowseFolder_Click"
                    VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#0D1117"
                    BorderBrush="#333"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogBox"
                             Text="{Binding GenerationLog}"
                             Background="Transparent"
                             Foreground="#00FF88"
                             FontFamily="Consolas"
                             FontSize="12"
                             BorderThickness="0"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        MinWidth="180">
                <Button x:Name="GenerateBtn"
                        Content="Generate Output"
                        Style="{StaticResource GoldBtn}"
                        IsEnabled="{Binding IsGenerating, Converter={StaticResource InvBool}}"
                        Click="GenerateBtn_Click"/>

                <TextBlock Text="Processing..."
                           Foreground="#D4AF37"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"
                           Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"/>

                <TextBlock x:Name="PhaseALabel"
                           Text="Phase A - T-SQL"
                           Foreground="#555"
                           FontSize="12"
                           Margin="0,20,0,6"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="PhaseBLabel"
                           Text="Phase B - RDLC XML"
                           Foreground="#555"
                           FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
