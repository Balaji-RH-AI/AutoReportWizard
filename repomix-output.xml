using System.Data;
using Microsoft.Data.SqlClient;
using System.Collections.Generic;
using System.Threading.Tasks;
using AutoReportWizard.Models;

public async Task<List<ReportField>> ImportStoredProcedureSchemaAsync(string connectionString, string spName, Dictionary<string, object> testParameters)
{
    var fields = new List<ReportField>();

    using var connection = new SqlConnection(connectionString);
    await connection.OpenAsync();

    using var cmd = new SqlCommand(spName, connection);
    cmd.CommandType = CommandType.StoredProcedure;

    // Inject the test parameters so the SP can execute successfully
    foreach (var param in testParameters)
    {
        cmd.Parameters.AddWithValue(param.Key, param.Value ?? DBNull.Value);
    }

    // Execute the SP and capture the output shape
    using var reader = await cmd.ExecuteReaderAsync();

    // Read the column schema directly from the execution result
    var schemaTable = reader.GetSchemaTable();

    if (schemaTable != null)
    {
        int displayOrder = 0;
        foreach (DataRow row in schemaTable.Rows)
        {
            string columnName = row["ColumnName"].ToString() ?? string.Empty;
            string dataType = row["DataType"]?.ToString() ?? "System.String";

            fields.Add(new ReportField
            {
                Name = columnName, // This will instantly capture your alias (e.g., 'BatchNum')
                DotNetType = dataType,
                IsDetailField = true,
                DisplayOrder = displayOrder++,
                // Grid-snapped defaults for the Canvas
                ItemWidth = 120,
                ItemHeight = 32,
                CanvasX = 16,
                CanvasY = 16,
                TextAlign = "Default",
                FontWeight = "Normal",
                BorderColor = "LightGrey",
                BackgroundColor = "Transparent"
            });
        }
    }

    return fields;
}


