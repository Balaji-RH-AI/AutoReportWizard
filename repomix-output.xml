<Window x:Class="AutoReportWizard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:System.Windows.Controls"
        xmlns:local="clr-namespace:AutoReportWizard"
        Title="AutoReport Wizard"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <Style x:Key="NavBtn"
                TargetType="Button">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter Property="Opacity"
                                        Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarText"
                TargetType="FrameworkElement">
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarToggle}"
                        Value="True">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarContainer"
                TargetType="Border">
            <Setter Property="Width"
                    Value="260"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarToggle}"
                        Value="True">
                    <Setter Property="Width"
                            Value="65"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource SidebarContainer}"
                Background="#111111"
                BorderBrush="#222"
                BorderThickness="0,0,1,0"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="SidebarToggle"
                                  Width="35"
                                  Height="35"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  ToolTip="Toggle Sidebar">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent"
                                        CornerRadius="0">
                                    <TextBlock Text="☰"
                                               Foreground="#CCC"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock Text="AutoReport Wizard"
                               Style="{StaticResource SidebarText}"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                        Margin="0,20,0,0">
                    <Grid Margin="0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Icon1"
                                Grid.Column="0"
                                Text="○"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="Text1"
                                Grid.Column="1"
                                Text="Target Environment"
                                Style="{StaticResource SidebarText}"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                    </Grid>

                    <Grid Margin="0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Icon2"
                                Grid.Column="0"
                                Text="○"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="Text2"
                                Grid.Column="1"
                                Text="Dataset Definition"
                                Style="{StaticResource SidebarText}"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                    </Grid>

                    <Grid Margin="0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Icon3"
                                Grid.Column="0"
                                Text="○"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="Text3"
                                Grid.Column="1"
                                Text="Group By &amp; Aggregation"
                                Style="{StaticResource SidebarText}"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                    </Grid>

                    <Grid Margin="0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Icon4"
                                Grid.Column="0"
                                Text="○"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="Text4"
                                Grid.Column="1"
                                Text="Header &amp; Footer"
                                Style="{StaticResource SidebarText}"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                    </Grid>

                    <Grid Margin="0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Icon5"
                                Grid.Column="0"
                                Text="○"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="Text5"
                                Grid.Column="1"
                                Text="Layout &amp; Generate"
                                Style="{StaticResource SidebarText}"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                    </Grid>

                    <Grid Margin="0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Icon6"
                                Grid.Column="0"
                                Text="○"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="Text6"
                                Grid.Column="1"
                                Text="Output &amp; Generate"
                                Style="{StaticResource SidebarText}"
                                FontSize="14"
                                FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="#222"
                        BorderThickness="0,1,0,0"
                        Padding="0,15">
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Change Connection"
                            Click="ChangeConnection_Click"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="⚙️"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SidebarText}">
                                <TextBlock Text="Change Connection"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DatabaseName}"
                                           Foreground="#00FF88"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="170"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
                Background="{DynamicResource WindowBackgroundBrush}">

            <Grid Margin="40,40,40,90">
                <ContentControl x:Name="MainContentArea"/>

                <Grid Background="#B2000000"
                      Panel.ZIndex="999"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="260"
                                     Height="4"
                                     Background="#222222"
                                     Foreground="{DynamicResource AccentGoldBrush}"
                                     Margin="0,0,0,16"/>
                        <TextBlock Text="PROCESSING..."
                                   Foreground="{DynamicResource AccentGoldBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,40,30"
                        Panel.ZIndex="100">

                <Button x:Name="BackButton"
                        Content="← Back"
                        Width="110"
                        Padding="0,11"
                        Margin="0,0,15,0"
                        Style="{StaticResource NavBtn}"
                        Background="#252525"
                        Foreground="#CCC"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        Click="BackButton_Click"/>

                <Button x:Name="NextButton"
                        Content="Next →"
                        Width="160"
                        Padding="0,11"
                        Style="{StaticResource NavBtn}"
                        Background="{DynamicResource AccentGoldBrush}"
                        Foreground="{DynamicResource WindowBackgroundBrush}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        Click="NextButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
</file>

