<UserControl x:Class="AutoReportWizard.Views.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32">
            <StackPanel>
                <!-- Headers -->
                <TextBlock Text="Dataset Definition"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="22" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" TextWrapping="Wrap"
                           Margin="0,0,0,32"
                           Text="Which fields do you want on your report? Select a database and table, then choose your fields."/>

                <!-- Card 1: Advanced Import (Direct SP Import) -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="ALTERNATIVE TOOL: DIRECT STORED PROCEDURE IMPORT"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Medium" FontSize="12"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Bypass the manual table builder. Type your exact Stored Procedure name (e.g., [Schema].[Name]) to instantly capture and map all output fields."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0"
                                     Text="{Binding ExistingSpName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="e.g., [PSGTMS].[Retail_ACS_BatchDetailReport]"/>
                            
                            <Button Grid.Column="1"
                                    Content="Import SP Schema"
                                    Command="{Binding ImportSpCommand}"
                                    Style="{StaticResource NeoPillButton}"
                                    Margin="16,0,0,0"/>
                        </Grid>
                        
                        <TextBlock Text="{Binding DiscoveryError}"
                                   Foreground="{StaticResource AccentGoldBrush}"
                                   FontSize="13" FontWeight="Medium"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding HasDiscoveryError, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
                
                <!-- Card 2: Database / Schema / Table selection -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Database -->
                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DATABASE"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Medium" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="↻ Load"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Cursor="Hand"
                                           MouseDown="RefreshDatabases_MouseDown"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ToggleButton x:Name="DbToggle" Style="{StaticResource DropdownToggle}">
                                <TextBlock Text="{Binding SelectedDatabase, TargetNullValue='Select Database...'}"/>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=DbToggle}"
                                   StaysOpen="False" PlacementTarget="{Binding ElementName=DbToggle}">
                                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                                        Width="{Binding ActualWidth, ElementName=DbToggle}" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel Margin="0,8">
                                        <TextBox Background="{StaticResource WindowBackgroundBrush}" Margin="12,0,12,8" Tag="{Binding ElementName=DbList}" TextChanged="SearchBox_TextChanged"/>
                                        <ListBox x:Name="DbList" ItemsSource="{Binding AvailableDatabases}" SelectedItem="{Binding SelectedDatabase, Mode=TwoWay}"
                                                 MaxHeight="200" Background="Transparent" BorderThickness="0" Tag="{Binding ElementName=DbToggle}" SelectionChanged="DropdownList_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                        
                        <!-- Schema -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SCHEMA" Foreground="{StaticResource AccentBrush}" FontWeight="Medium" FontSize="12" Margin="0,0,0,8"/>
                            <ToggleButton x:Name="SchemaToggle" Style="{StaticResource DropdownToggle}">
                                <TextBlock Text="{Binding SelectedSchema, TargetNullValue='Select Schema...'}"/>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=SchemaToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=SchemaToggle}">
                                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="{Binding ActualWidth, ElementName=SchemaToggle}" Margin="0,4,0,0">
                                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.5"/></Border.Effect>
                                    <StackPanel Margin="0,8">
                                        <TextBox Background="{StaticResource WindowBackgroundBrush}" Margin="12,0,12,8" Tag="{Binding ElementName=SchemaList}" TextChanged="SearchBox_TextChanged"/>
                                        <ListBox x:Name="SchemaList" ItemsSource="{Binding AvailableSchemas}" SelectedItem="{Binding SelectedSchema, Mode=TwoWay}" MaxHeight="200" Background="Transparent" BorderThickness="0" Tag="{Binding ElementName=SchemaToggle}" SelectionChanged="DropdownList_SelectionChanged">
                                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style></ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                        
                        <!-- Table -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="TABLES / QUERIES" Foreground="{StaticResource AccentBrush}" FontWeight="Medium" FontSize="12" Margin="0,0,0,8"/>
                            <ToggleButton x:Name="TableToggle" Style="{StaticResource DropdownToggle}">
                                <TextBlock Text="{Binding SelectedTable, TargetNullValue='Select Table...'}"/>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=TableToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=TableToggle}">
                                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="{Binding ActualWidth, ElementName=TableToggle}" Margin="0,4,0,0">
                                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.5"/></Border.Effect>
                                    <StackPanel Margin="0,8">
                                        <TextBox Background="{StaticResource WindowBackgroundBrush}" Margin="12,0,12,8" Tag="{Binding ElementName=TableList}" TextChanged="SearchBox_TextChanged"/>
                                        <ListBox x:Name="TableList" ItemsSource="{Binding AvailableTables}" SelectedItem="{Binding SelectedTable, Mode=TwoWay}" MaxHeight="200" Background="Transparent" BorderThickness="0" Tag="{Binding ElementName=TableToggle}" SelectionChanged="DropdownList_SelectionChanged">
                                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style></ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Card 3: Relational Table Joins -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="RELATIONAL TABLE JOINS"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Medium" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Button Content="+ Add Table Join"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource DarkBtn}"
                                    Padding="16,8"
                                    Click="AddJoin_Click"/>
                        </DockPanel>
                        <TextBlock Text="Connect additional tables to the selected base table using a primary key and matching foreign key."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" TextWrapping="Wrap"
                                   Margin="0,0,0,24"/>
                        
                        <!-- Join Items Control -->
                        <ItemsControl ItemsSource="{Binding ConfiguredJoins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource WindowBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Margin="0,0,0,12"
                                            Padding="20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="PRIMARY TABLE" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Medium" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding PrimaryTable}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                <TextBlock Text="PRIMARY KEY" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Medium" Margin="0,0,0,8"/>
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding PrimaryColumn, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                                <TextBlock Text="JOINED TABLE" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Medium" Margin="0,0,0,8"/>
                                                <ToggleButton x:Name="JoinTableToggle" Style="{StaticResource DropdownToggle}">
                                                    <TextBlock Text="{Binding JoinedTable, TargetNullValue='Select...'}" VerticalAlignment="Center"/>
                                                </ToggleButton>
                                                <Popup IsOpen="{Binding IsChecked, ElementName=JoinTableToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=JoinTableToggle}">
                                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="{Binding ActualWidth, ElementName=JoinTableToggle}" Margin="0,4,0,0">
                                                        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.5"/></Border.Effect>
                                                        <StackPanel Margin="0,8">
                                                            <TextBox Background="{StaticResource WindowBackgroundBrush}" Margin="12,0,12,8" Tag="{Binding ElementName=JoinTableList}" TextChanged="SearchBox_TextChanged"/>
                                                            <ListBox x:Name="JoinTableList" ItemsSource="{Binding DataContext.AvailableTables, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding JoinedTable, Mode=TwoWay}" MaxHeight="150" Background="Transparent" BorderThickness="0" Tag="{Binding ElementName=JoinTableToggle}" SelectionChanged="DropdownList_SelectionChanged">
                                                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style></ListBox.ItemContainerStyle>
                                                            </ListBox>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,0,16,0">
                                                <TextBlock Text="FOREIGN KEY" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Medium" Margin="0,0,0,8"/>
                                                <TextBox Text="{Binding JoinedColumn, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Button Grid.Column="4" Content="✕"
                                                    VerticalAlignment="Bottom"
                                                    Style="{StaticResource DarkBtn}"
                                                    Foreground="{StaticResource AccentGoldBrush}"
                                                    Padding="12,10"
                                                    Margin="0,0,0,2"
                                                    ToolTip="Remove Join"
                                                    Tag="{Binding}" Click="DeleteJoin_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                
                <!-- Card 4: Field Selection -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Available Fields -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="AVAILABLE FIELDS" Foreground="{StaticResource AccentBrush}" FontWeight="Medium" FontSize="12" Margin="0,0,0,12"/>
                            <Border Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                <ListBox x:Name="AvailableList" ItemsSource="{Binding AvailableFields}"
                                         Background="Transparent" BorderThickness="0" Foreground="White" Height="300" SelectionMode="Extended"
                                         Margin="4">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <TextBlock Text="{Binding SourceTable, StringFormat='[{0}].'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                        
<!-- Transfer Buttons -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                            <!-- Single Move -->
                            <Button Content="❯" Style="{StaticResource TransferBtn}" Click="MoveRight_Click" Margin="0,0,0,8" FontSize="16" FontWeight="Bold"/>
                            <!-- Move All -->
                            <Button Content="❯❯" Style="{StaticResource TransferBtn}" Click="MoveAllRight_Click" Margin="0,0,0,24" FontSize="16" FontWeight="Bold"/>
                            
                            <!-- Single Move Back -->
                            <Button Content="❮" Style="{StaticResource TransferBtn}" Click="MoveLeft_Click" Margin="0,0,0,8" FontSize="16" FontWeight="Bold"/>
                            <!-- Move All Back -->
                            <Button Content="❮❮" Style="{StaticResource TransferBtn}" Click="MoveAllLeft_Click" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        
                        <!-- Selected Fields -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SELECTED FIELDS" Foreground="{StaticResource AccentBrush}" FontWeight="Medium" FontSize="12" Margin="0,0,0,12"/>
                            <Border Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                <ListBox x:Name="SelectedList" ItemsSource="{Binding Fields}"
                                         Background="Transparent" BorderThickness="0" Foreground="White" Height="300" SelectionMode="Extended"
                                         Margin="4">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <TextBlock Text="{Binding SourceTable, StringFormat='[{0}].'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>