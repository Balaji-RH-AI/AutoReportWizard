<UserControl x:Class="AutoReportWizard.Views.Step2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32">
            <StackPanel>
                <!-- Headers -->
                <TextBlock Text="Stored Procedure Selection"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="22" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" TextWrapping="Wrap"
                           Margin="0,0,0,32"
                           Text="Select a database, schema, and stored procedure. The engine will automatically map its outputs to the report design in later steps."/>

                <!-- Card 1: Database / Schema / SP selection -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,0,24">
                    <StackPanel>
                        
                        <!-- Notification for Discovery Error -->
                        <TextBlock Text="{Binding DiscoveryError}"
                                   Foreground="{StaticResource AccentGoldBrush}"
                                   FontSize="13" FontWeight="Medium"
                                   Margin="0,0,0,16"
                                   Visibility="{Binding HasDiscoveryError, Converter={StaticResource BoolToVis}}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Database -->
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DATABASE"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Medium" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" 
                                            Command="{Binding LoadDatabasesCommand}" 
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" Padding="0">
                                        <TextBlock Text="↻ Load"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                                <ToggleButton x:Name="DbToggle" Style="{StaticResource DropdownToggle}">
                                    <TextBlock Text="{Binding SelectedDatabase, TargetNullValue='Select Database...'}"/>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=DbToggle}"
                                       StaysOpen="False" PlacementTarget="{Binding ElementName=DbToggle}">
                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                                            Width="{Binding ActualWidth, ElementName=DbToggle}" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel Margin="0,8">
                                            <TextBox Background="{StaticResource WindowBackgroundBrush}" Margin="12,0,12,8" Text="{Binding DatabaseSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ListBox x:Name="DbList" ItemsSource="{Binding AvailableDatabases}" SelectedItem="{Binding SelectedDatabase, Mode=TwoWay}"
                                                     MaxHeight="200" Background="Transparent" BorderThickness="0" Tag="{Binding ElementName=DbToggle}" SelectionChanged="DropdownList_SelectionChanged">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="Padding" Value="12,6" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                            
                            <!-- Schema -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SCHEMA" Foreground="{StaticResource AccentBrush}" FontWeight="Medium" FontSize="12" Margin="0,0,0,8"/>
                                <ToggleButton x:Name="SchemaToggle" Style="{StaticResource DropdownToggle}">
                                    <TextBlock Text="{Binding SelectedSchema, TargetNullValue='Select Schema...'}"/>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=SchemaToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=SchemaToggle}">
                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="{Binding ActualWidth, ElementName=SchemaToggle}" Margin="0,4,0,0">
                                        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.5"/></Border.Effect>
                                        <StackPanel Margin="0,8">
                                            <TextBox Background="{StaticResource WindowBackgroundBrush}" Margin="12,0,12,8" Text="{Binding SchemaSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ListBox x:Name="SchemaList" ItemsSource="{Binding AvailableSchemas}" SelectedItem="{Binding SelectedSchema, Mode=TwoWay}" MaxHeight="200" Background="Transparent" BorderThickness="0" Tag="{Binding ElementName=SchemaToggle}" SelectionChanged="DropdownList_SelectionChanged">
                                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="Padding" Value="12,6" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                </Style></ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                            
                            <!-- Stored Procedure -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="STORED PROCEDURE" Foreground="{StaticResource AccentBrush}" FontWeight="Medium" FontSize="12" Margin="0,0,0,8"/>
                                <ToggleButton x:Name="SpToggle" Style="{StaticResource DropdownToggle}">
                                    <TextBlock Text="{Binding SelectedStoredProcedure, TargetNullValue='Select Procedure...'}"/>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=SpToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=SpToggle}">
                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="{Binding ActualWidth, ElementName=SpToggle}" Margin="0,4,0,0">
                                        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.5"/></Border.Effect>
                                        <StackPanel Margin="0,8">
                                            <TextBox Background="{StaticResource WindowBackgroundBrush}" Margin="12,0,12,8" Text="{Binding SpSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ListBox x:Name="SpList" ItemsSource="{Binding AvailableStoredProcedures}" SelectedItem="{Binding SelectedStoredProcedure, Mode=TwoWay}" MaxHeight="200" Background="Transparent" BorderThickness="0" Tag="{Binding ElementName=SpToggle}" SelectionChanged="DropdownList_SelectionChanged">
                                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="Padding" Value="12,6" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                </Style></ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>