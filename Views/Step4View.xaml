<UserControl x:Class="AutoReportWizard.Views.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

        <UserControl.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                <Style x:Key="ToggleRow"
                       TargetType="Border">
                        <Setter Property="Background"
                                Value="#1A1A1A"/>
                        <Setter Property="CornerRadius"
                                Value="6"/>
                        <Setter Property="Padding"
                                Value="16,12"/>
                        <Setter Property="Margin"
                                Value="0,0,0,10"/>
                        <Setter Property="BorderBrush"
                                Value="#333"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                </Style>
                <Style x:Key="ToggleLabel"
                       TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                </Style>
                <Style x:Key="ToggleDesc"
                       TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="#777"/>
                        <Setter Property="FontSize"
                                Value="11"/>
                </Style>
        </UserControl.Resources>

        <Grid Margin="20">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,24">
                        <TextBlock Text="Header &amp; Footer Configuration"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Set your report title and configure footer elements."
                                   Foreground="Gray"
                                   FontSize="13"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                        <TextBlock Text="Report Title"
                                                   Foreground="#D4AF37"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1A1A1A"
                                                 Foreground="White"
                                                 BorderBrush="#444"
                                                 Padding="10"
                                                 FontSize="14"
                                                 Margin="0,0,0,20"/>

                                        <TextBlock Text="Subtitle / Description"
                                                   Foreground="#D4AF37"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding ReportSubtitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1A1A1A"
                                                 Foreground="White"
                                                 BorderBrush="#444"
                                                 Padding="10"
                                                 FontSize="13"
                                                 AcceptsReturn="True"
                                                 MinLines="4"
                                                 Margin="0,0,0,20"/>

                                        <TextBlock Text="Page Header Field Mappings"
                                                   Foreground="#D4AF37"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="Select dataset columns to populate the page header labels using SSRS expressions."
                                                   Foreground="#777"
                                                   FontSize="11"
                                                   Margin="0,0,0,10"
                                                   TextWrapping="Wrap"/>
                                        <Border Background="#151515"
                                                BorderBrush="#333"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12"
                                                Margin="0,0,0,20">
                                                <StackPanel>
                                                        <TextBlock Text="Site"
                                                                   Foreground="White"
                                                                   FontSize="13"
                                                                   Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding Fields}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Name"
                                                                  SelectedValue="{Binding HeaderSiteField, UpdateSourceTrigger=PropertyChanged}"
                                                                  Background="#1A1A1A"
                                                                  Foreground="White"
                                                                  BorderBrush="#444"
                                                                  Padding="8"
                                                                  Margin="0,0,0,10"/>

                                                        <TextBlock Text="Process Date"
                                                                   Foreground="White"
                                                                   FontSize="13"
                                                                   Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding Fields}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Name"
                                                                  SelectedValue="{Binding HeaderProcessDateField, UpdateSourceTrigger=PropertyChanged}"
                                                                  Background="#1A1A1A"
                                                                  Foreground="White"
                                                                  BorderBrush="#444"
                                                                  Padding="8"
                                                                  Margin="0,0,0,10"/>

                                                        <TextBlock Text="Julian Date"
                                                                   Foreground="White"
                                                                   FontSize="13"
                                                                   Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding Fields}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Name"
                                                                  SelectedValue="{Binding HeaderJulianField, UpdateSourceTrigger=PropertyChanged}"
                                                                  Background="#1A1A1A"
                                                                  Foreground="White"
                                                                  BorderBrush="#444"
                                                                  Padding="8"
                                                                  Margin="0,0,0,10"/>

                                                        <TextBlock Text="Worksource"
                                                                   Foreground="White"
                                                                   FontSize="13"
                                                                   Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding Fields}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Name"
                                                                  SelectedValue="{Binding HeaderWorksourceField, UpdateSourceTrigger=PropertyChanged}"
                                                                  Background="#1A1A1A"
                                                                  Foreground="White"
                                                                  BorderBrush="#444"
                                                                  Padding="8"
                                                                  Margin="0,0,0,10"/>

                                                        <TextBlock Text="Load Number"
                                                                   Foreground="White"
                                                                   FontSize="13"
                                                                   Margin="0,0,0,4"/>
                                                        <ComboBox ItemsSource="{Binding Fields}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Name"
                                                                  SelectedValue="{Binding HeaderLoadField, UpdateSourceTrigger=PropertyChanged}"
                                                                  Background="#1A1A1A"
                                                                  Foreground="White"
                                                                  BorderBrush="#444"
                                                                  Padding="8"/>
                                                </StackPanel>
                                        </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                        <TextBlock Text="Footer Elements"
                                                   Foreground="#D4AF37"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>

                                        <Border Style="{StaticResource ToggleRow}">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="⏱ Execution Time"
                                                                           Style="{StaticResource ToggleLabel}"/>
                                                                <TextBlock Text="Show time on the bottom left."
                                                                           Style="{StaticResource ToggleDesc}"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IncludeExecutionTime}"/>
                                                </Grid>
                                        </Border>

                                        <Border Style="{StaticResource ToggleRow}">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="📄 Page Numbers"
                                                                           Style="{StaticResource ToggleLabel}"/>
                                                                <TextBlock Text="Show Page N of M on the bottom right."
                                                                           Style="{StaticResource ToggleDesc}"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IncludePageNumbers}"/>
                                                </Grid>
                                        </Border>
                                </StackPanel>
                        </Grid>
                </ScrollViewer>
        </Grid>
</UserControl>