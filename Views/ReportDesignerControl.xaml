<UserControl x:Class="AutoReportWizard.Views.ReportDesignerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AutoReportWizard.Views"
             xmlns:models="clr-namespace:AutoReportWizard.Models"
             xmlns:vm="clr-namespace:AutoReportWizard.ViewModels"
             xmlns:infra="clr-namespace:AutoReportWizard"
             xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WizardViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             Background="{DynamicResource PanelBackgroundBrush}"
             Foreground="{DynamicResource TextSecondaryBrush}"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>
        <!-- Converters for the Live Preview tab -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <infra:InverseBoolConverter x:Key="InvBool"/>

        <Style x:Key="ToolboxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type models:TextComponent}">
            <TextBlock Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                       FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontFamily}"
                       Foreground="White"
                       Width="{Binding Width}"
                       Height="{Binding Height}"
                       TextWrapping="Wrap"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:ImageComponent}">
            <Grid Width="{Binding Width}" Height="{Binding Height}">
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource HeaderBackgroundBrush}">
                    <Grid>
                        <TextBlock Text="📷 Image Component"
                                   Foreground="#808080"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="4"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Image Source="{Binding SourcePath, TargetNullValue={x:Null}}"
                               Stretch="Uniform"
                               Margin="2"/>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:LineComponent}">
            <Grid Width="{Binding Width}" Height="{Binding Height}">
                <Rectangle Fill="{DynamicResource AccentGoldBrush}"
                           Height="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"
                           x:Name="HLine"/>
                <Rectangle Fill="{DynamicResource AccentGoldBrush}"
                           Width="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Stretch"
                           x:Name="VLine"
                           Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Orientation}" Value="Vertical">
                    <Setter TargetName="HLine" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="VLine" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="150" MaxWidth="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <!-- Dynamically Bound Properties Column -->
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="280"/>
                        <Setter Property="MinWidth" Value="240"/>
                        <Setter Property="MaxWidth" Value="400"/>
                        <Style.Triggers>
                            <!-- Collapse to 0 width when toggle is unchecked -->
                            <DataTrigger Binding="{Binding IsChecked, ElementName=PropertiesToggle}" Value="False">
                                <Setter Property="Width" Value="0"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MaxWidth" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBackgroundBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource BorderBrush}"
                        Padding="10,8"
                        BorderBrush="{DynamicResource PanelBackgroundBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧰" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="DESIGNER TOOLBOX"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <TextBlock Text="Drag elements onto the canvas:"
                                   Foreground="#808080"
                                   FontSize="10"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <ListBox x:Name="ToolboxList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            
                            <!-- TextBlock Tool -->
                            <ListBoxItem Style="{StaticResource ToolboxItemStyle}"
                                         Tag="Text"
                                         MouseMove="ToolboxItem_MouseMove">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔤 " Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                    <TextBlock Text="TextBlock (Label)" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </ListBoxItem>

                            <!-- Separator Line Tool -->
                            <ListBoxItem Style="{StaticResource ToolboxItemStyle}"
                                         Tag="Line"
                                         MouseMove="ToolboxItem_MouseMove">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➖ " Foreground="{DynamicResource AccentGoldBrush}" FontWeight="Bold"/>
                                    <TextBlock Text="Separator Line" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource PanelBackgroundBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}">
            <!-- Toggle Button for Properties Sidebar -->
            <ToggleButton x:Name="PropertiesToggle"
                          IsChecked="False"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,2,8,0"
                          Panel.ZIndex="10"
                          Cursor="Hand"
                          ToolTip="Toggle Properties Sidebar">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Properties" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <TabControl Background="Transparent" BorderThickness="0" Margin="0" x:Name="MainTabs">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <ContentPresenter Content="{TemplateBinding Content}" Margin="12,5"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderThickness="0,2,0,0"
                                            BorderBrush="Transparent"
                                            Margin="0,0,1,0">
                                        <ContentPresenter x:Name="ContentSite"
                                                          ContentSource="Header"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="📐 Report Designer" x:Name="DesignTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="50,0,0,0">
                                    <TextBlock Text="0px" Foreground="#808080" FontSize="9" Width="100"/>
                                    <TextBlock Text="100px" Foreground="#808080" FontSize="9" Width="100"/>
                                    <TextBlock Text="200px" Foreground="#808080" FontSize="9" Width="100"/>
                                    <TextBlock Text="300px" Foreground="#808080" FontSize="9" Width="100"/>
                                    <TextBlock Text="400px" Foreground="#808080" FontSize="9" Width="100"/>
                                    <TextBlock Text="500px" Foreground="#808080" FontSize="9" Width="100"/>
                                    <TextBlock Text="600px" Foreground="#808080" FontSize="9"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource PanelBackgroundBrush}">
                            <Grid Margin="30">
                                <Border Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Width="794"
                                        Height="1123"
                                        SnapsToDevicePixels="True"
                                        CornerRadius="2"
                                        x:Name="CanvasSurface">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.25" ShadowDepth="4" Direction="270"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.Background>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                                <DrawingBrush.Drawing>
                                                    <GeometryDrawing>
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <LineGeometry StartPoint="0,0" EndPoint="16,0"/>
                                                                <LineGeometry StartPoint="0,0" EndPoint="0,16"/>
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                        <GeometryDrawing.Pen>
                                                            <Pen Brush="{DynamicResource HeaderBackgroundBrush}" Thickness="0.5"/>
                                                        </GeometryDrawing.Pen>
                                                    </GeometryDrawing>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Grid.Background>

                                        <ListBox x:Name="DesignerCanvas"
                                                 ItemsSource="{Binding CanvasComponents}"
                                                 SelectedItem="{Binding SelectedComponent}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 AllowDrop="True"
                                                 DragEnter="Canvas_DragEnter"
                                                 DragOver="Canvas_DragOver"
                                                 Drop="Canvas_Drop"
                                                 PreviewKeyDown="Canvas_PreviewKeyDown">

                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Background="Transparent" IsItemsHost="True"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
                                                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Grid>
                                                                    <Border x:Name="ItemBorder"
                                                                            BorderThickness="1"
                                                                            BorderBrush="Transparent"
                                                                            Background="Transparent"
                                                                            Padding="1"
                                                                            MouseDown="CanvasItem_MouseDown">
                                                                        <ContentPresenter/>
                                                                    </Border>

                                                                    <Canvas x:Name="SelectionAdorners" Visibility="Collapsed" IsHitTestVisible="True">
                                                                        <Rectangle Stroke="{DynamicResource AccentBrush}"
                                                                                   StrokeDashArray="3 2"
                                                                                   StrokeThickness="1"
                                                                                   Width="{Binding Width}"
                                                                                   Height="{Binding Height}"
                                                                                   Margin="1"/>

                                                                        <Border Background="{DynamicResource AccentBrush}"
                                                                                CornerRadius="1"
                                                                                Padding="3,1"
                                                                                Canvas.Top="-18"
                                                                                Canvas.Left="0">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="X:" Foreground="#99FFFFFF" FontSize="8" FontWeight="Bold"/>
                                                                                <TextBlock Text="{Binding X, StringFormat={}{0:F0}}" Foreground="White" FontSize="8" Margin="1,0,4,0"/>
                                                                                <TextBlock Text="Y:" Foreground="#99FFFFFF" FontSize="8" FontWeight="Bold"/>
                                                                                <TextBlock Text="{Binding Y, StringFormat={}{0:F0}}" Foreground="White" FontSize="8" Margin="1,0,4,0"/>
                                                                                <TextBlock Text="W:" Foreground="#99FFFFFF" FontSize="8" FontWeight="Bold"/>
                                                                                <TextBlock Text="{Binding Width, StringFormat={}{0:F0}}" Foreground="White" FontSize="8" Margin="1,0,4,0"/>
                                                                                <TextBlock Text="H:" Foreground="#99FFFFFF" FontSize="8" FontWeight="Bold"/>
                                                                                <TextBlock Text="{Binding Height, StringFormat={}{0:F0}}" Foreground="White" FontSize="8"/>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <Thumb x:Name="ResizeHandleSE"
                                                                               Width="7"
                                                                               Height="7"
                                                                               Background="{DynamicResource AccentBrush}"
                                                                               BorderBrush="White"
                                                                               BorderThickness="1"
                                                                               Cursor="SizeNWSE"
                                                                               Canvas.Left="{Binding Width}"
                                                                               Canvas.Top="{Binding Height}"
                                                                               DragDelta="ResizeHandle_DragDelta"/>
                                                                    </Canvas>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="SelectionAdorners" Property="Visibility" Value="Visible"/>
                                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="📄 Print Layout Preview" x:Name="PreviewTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="15,6">
                            <Grid>
                                <TextBlock Text="📄 This is a high-fidelity rendering of your compiled layout. All handles and grid indicators are removed."
                                           Foreground="#808080"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                                <Button Content="🖨️ Export PDF / Print Layout"
                                        HorizontalAlignment="Right"
                                        Padding="10,4"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="PrintReport_Click"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      Background="{DynamicResource PanelBackgroundBrush}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid Margin="30">
                                <Border Background="White"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Width="794"
                                        Height="1123"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.5" ShadowDepth="4" Direction="270"/>
                                    </Border.Effect>
                                    <ItemsControl ItemsSource="{Binding CanvasComponents}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Background="Transparent" IsItemsHost="True"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>

                                        <ItemsControl.Resources>
                                            <DataTemplate DataType="{x:Type models:TextComponent}">
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="{Binding FontSize}"
                                                           FontFamily="{Binding FontFamily}"
                                                           Foreground="Black"
                                                           Width="{Binding Width}"
                                                           Height="{Binding Height}"
                                                           TextWrapping="Wrap"/>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type models:ImageComponent}">
                                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                    <Image Source="{Binding SourcePath, TargetNullValue={x:Null}}" Stretch="Uniform"/>
                                                </Grid>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type models:LineComponent}">
                                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                    <Rectangle Fill="Black"
                                                               Height="1.5"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Stretch"
                                                               x:Name="HLine"/>
                                                    <Rectangle Fill="Black"
                                                               Width="1.5"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Stretch"
                                                               x:Name="VLine"
                                                               Visibility="Collapsed"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Orientation}" Value="Vertical">
                                                        <Setter TargetName="HLine" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="VLine" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.Resources>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="▶ Live Preview" x:Name="LivePreviewTab">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Left: parameter sidebar (fixed, min 200, max 340) -->
                            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="340"/>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Right: ReportViewer host -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── Parameter Sidebar ─────────────────────────────── -->
                        <Border Grid.Column="0"
                                Background="#111111"
                                BorderBrush="#333333"
                                BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Sidebar header -->
                                <Border Grid.Row="0"
                                        Background="#1A1A2E"
                                        BorderBrush="#333333"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="PARAMETERS" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Set values then click Render" FontSize="9" Foreground="#666666" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Parameter list -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
                                    <StackPanel>
                                        <!-- Empty-state message when no parameters exist -->
                                        <TextBlock Foreground="#555555"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"
                                                   Text="No parameters defined. Add parameters in Step 4 to filter your report data.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DynamicParameters.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Dynamic parameter inputs -->
                                        <ItemsControl ItemsSource="{Binding DynamicParameters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,14"
                                                            Padding="10,8"
                                                            Background="{DynamicResource ControlBackgroundBrush}"
                                                            BorderBrush="#2A2A2A"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                                <TextBlock Text="{Binding PromptText}" Foreground="{DynamicResource AccentGoldBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding ParameterName, StringFormat=' ({0})'}" Foreground="#666666" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Bottom"/>
                                                            </StackPanel>
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="#0D0D0D"
                                                                     Foreground="White"
                                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                                     Padding="7,5"
                                                                     FontSize="12"
                                                                     BorderThickness="1"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Render button + error area -->
                                <Border Grid.Row="2"
                                        Background="#0D0D0D"
                                        BorderBrush="#333333"
                                        BorderThickness="0,1,0,0"
                                        Padding="12,10">
                                    <StackPanel>
                                        <!-- Inline error feedback -->
                                        <Border Background="#3B0000"
                                                BorderBrush="#7F1D1D"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,5"
                                                Margin="0,0,0,8"
                                                Visibility="{Binding HasPreviewError, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PreviewError}" Foreground="#FF7777" FontSize="10" TextWrapping="Wrap" MaxHeight="60"/>
                                        </Border>

                                        <!-- Render / loading indicator -->
                                        <Button Content="▶  Render Report"
                                                Command="{Binding RunPreviewCommand}"
                                                IsEnabled="{Binding IsPreviewRunning, Converter={StaticResource InvBool}}"
                                                Background="{DynamicResource AccentGoldBrush}"
                                                Foreground="{DynamicResource WindowBackgroundBrush}"
                                                FontWeight="Bold"
                                                FontSize="13"
                                                Padding="0,10"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#B8962A"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Opacity" Value="0.4"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Spinner shown while preview is running -->
                                        <TextBlock Text="⏳  Rendering…"
                                                   Foreground="#888888"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"
                                                   Visibility="{Binding IsPreviewRunning, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ── Splitter ──────────────────────────────────────── -->
                        <GridSplitter Grid.Column="1"
                                      Width="4"
                                      HorizontalAlignment="Stretch"
                                      Background="{DynamicResource PanelBackgroundBrush}"
                                      ResizeBehavior="PreviousAndNext"/>

                        <!-- ── ReportViewer Host (right panel) ───────────────── -->
                        <Border Grid.Column="2" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="#333333" BorderThickness="0">
                            <Grid>
                                <!-- WindowsFormsHost: populated in code-behind -->
                                <wf:WindowsFormsHost x:Name="ReportHost" Visibility="{Binding HasPreviewData, Converter={StaticResource BoolToVis}}"/>

                                <!-- Placeholder shown before first render -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPreviewData}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="▶" FontSize="42" Foreground="#2A2A2A" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                    <TextBlock Text="Click  ▶ Render Report  to generate a live preview" Foreground="#555555" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="The viewer uses your field layout, column widths, and page header configuration."
                                               Foreground="#3A3A3A" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="380"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>

        <GridSplitter Grid.Column="3"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource PanelBackgroundBrush}"
                      ResizeBehavior="PreviousAndNext"
                      Visibility="{Binding IsChecked, ElementName=PropertiesToggle, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Column="4"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBackgroundBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource BorderBrush}"
                        Padding="10,8"
                        BorderBrush="{DynamicResource PanelBackgroundBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="⚙️" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="PROPERTIES GRID" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border x:Name="TypeBadgeBorder"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="4,1"
                                Visibility="Collapsed">
                            <TextBlock Text="COMPONENT" FontSize="8" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" x:Name="TypeBadgeText"/>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                    <Grid>
                        <StackPanel x:Name="NoSelectionPlaceholder" Margin="20,40,20,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                            <TextBlock Text="❓" FontSize="28" Foreground="#555555" Margin="0,0,0,10"/>
                            <TextBlock Text="No Selection" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Click on any element in the design canvas to configure its dimensions, position, and specific properties."
                                       Foreground="#808080" FontSize="10" TextWrapping="Wrap" LineHeight="14"/>
                        </StackPanel>

                        <Grid x:Name="PropertiesForm" DataContext="{Binding SelectedComponent}" Visibility="Collapsed">
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="LAYOUT (WPF CANVAS)" Foreground="#808080" FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Canvas.Left (X)" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource PanelBackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" Padding="4,2"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Canvas.Top (Y)" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource PanelBackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" Padding="4,2"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Width (px)" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource PanelBackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" Padding="4,2"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Height (px)" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource PanelBackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" Padding="4,2"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Z-Index Layer" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding ZIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource PanelBackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" Padding="4,2"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="SPECIFIC PROPERTIES" Foreground="#808080" FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ContentControl Content="{Binding}">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type models:TextComponent}">
                                            <StackPanel>
                                                <TextBlock Text="Label Text / Expression" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"
                                                         Background="{DynamicResource PanelBackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" Padding="4" Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Font Size (pt)" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource PanelBackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" Padding="4,2"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Font Family" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1" SelectedValue="{Binding FontFamily, Mode=TwoWay}" SelectedValuePath="Content" Background="{DynamicResource HeaderBackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}">
                                                        <ComboBoxItem Content="Segoe UI"/>
                                                        <ComboBoxItem Content="Arial"/>
                                                        <ComboBoxItem Content="Times New Roman"/>
                                                        <ComboBoxItem Content="Courier New"/>
                                                        <ComboBoxItem Content="Consolas"/>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>

                                        <DataTemplate DataType="{x:Type models:ImageComponent}">
                                            <StackPanel>
                                                <TextBlock Text="Source Path (Local / URL)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" Height="50" VerticalScrollBarVisibility="Auto"
                                                         Background="{DynamicResource PanelBackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" Padding="4" Margin="0,0,0,10"/>
                                                <TextBlock Text="e.g. C:\Assets\logo.png or http://..." Foreground="#808080" FontSize="9"/>
                                            </StackPanel>
                                        </DataTemplate>

                                        <DataTemplate DataType="{x:Type models:LineComponent}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Line Length" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource PanelBackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" Padding="4,2"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Orientation" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1" SelectedValue="{Binding Orientation, Mode=TwoWay}" SelectedValuePath="Content" Background="{DynamicResource HeaderBackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}">
                                                        <ComboBoxItem Content="Horizontal"/>
                                                        <ComboBoxItem Content="Vertical"/>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="FooterKeyboardGuide"
                        Grid.Row="2"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBackgroundBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="KEYBOARD ACTIONS:" FontWeight="Bold" FontSize="9" Foreground="#808080" Margin="0,0,0,4"/>
                        <TextBlock Text="• Drag element inside borders to reposition" FontSize="9" Foreground="#808080"/>
                        <TextBlock Text="• Drag blue corner handle to resize" FontSize="9" Foreground="#808080"/>
                        <Button Content="🗑️ Delete Component"
                                Command="{Binding DataContext.DeleteComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="6,4"
                                Background="#7F1D1D"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,8,0,0"
                                FontWeight="SemiBold"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>