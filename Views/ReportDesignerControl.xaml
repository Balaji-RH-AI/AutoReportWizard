<UserControl x:Class="AutoReportWizard.Views.ReportDesignerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AutoReportWizard.Views"
             xmlns:models="clr-namespace:AutoReportWizard.Models"
             xmlns:vm="clr-namespace:AutoReportWizard.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WizardViewModel}"
             d:DesignHeight="600"
        d:DesignWidth="1000"
             Background="#1E1E1E"
             Foreground="#CCCCCC"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>
        <Style x:Key="ToolboxItemStyle"
                TargetType="ListBoxItem">
            <Setter Property="Background"
                    Value="#2D2D30"/>
            <Setter Property="BorderBrush"
                    Value="#3E3E42"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10,8"/>
            <Setter Property="Margin"
                    Value="0,0,0,6"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter Property="Background"
                                        Value="#3E3E42"/>
                                <Setter Property="BorderBrush"
                                        Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type models:TextComponent}">
            <TextBlock Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                       FontSize="{Binding FontSize}"
                       FontFamily="{Binding FontFamily}"
                       Foreground="White"
                       Width="{Binding Width}"
                       Height="{Binding Height}"
                       TextWrapping="Wrap"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:ImageComponent}">
            <Grid Width="{Binding Width}"
                    Height="{Binding Height}">
                <Border BorderBrush="#3E3E42"
                        BorderThickness="1"
                        Background="#2D2D30">
                    <Grid>
                        <TextBlock Text="📷 Image Component"
                                Foreground="#808080"
                                FontSize="10"
                                   HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                   Margin="4"
                                TextAlignment="Center"
                                TextWrapping="Wrap"/>
                        <Image Source="{Binding SourcePath, TargetNullValue={x:Null}}"
                               Stretch="Uniform"
                               Margin="2"/>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:LineComponent}">
            <Grid Width="{Binding Width}"
                    Height="{Binding Height}">
                <Rectangle Fill="#D4AF37"
                        Height="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        x:Name="HLine"/>
                <Rectangle Fill="#D4AF37"
                        Width="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        x:Name="VLine"
                        Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Orientation}"
                        Value="Vertical">
                    <Setter TargetName="HLine"
                            Property="Visibility"
                            Value="Collapsed"/>
                    <Setter TargetName="VLine"
                            Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"
                    MinWidth="150"
                    MaxWidth="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="280"
                    MinWidth="240"
                    MaxWidth="400"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#2D2D30"
                BorderBrush="#1E1E1E"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#3E3E42"
                        Padding="10,8"
                        BorderBrush="#1E1E1E"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛠️"
                                FontSize="13"
                                Margin="0,0,6,0"/>
                        <TextBlock Text="DESIGNER TOOLBOX"
                                FontWeight="Bold"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Foreground="#CCCCCC"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        Margin="10">
                    <StackPanel>
                        <TextBlock Text="Drag elements onto the canvas:"
                                Foreground="#808080"
                                FontSize="10"
                                Margin="0,0,0,10"
                                TextWrapping="Wrap"/>

                        <ListBox x:Name="ToolboxList"
                                Background="Transparent"
                                BorderThickness="0"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBoxItem Style="{StaticResource ToolboxItemStyle}"
                                    Tag="Text"
                                    MouseMove="ToolboxItem_MouseMove">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔤 "
                                            Foreground="#007ACC"
                                            FontWeight="Bold"/>
                                    <TextBlock Text="TextBlock (Label)"
                                            Foreground="#CCCCCC"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Style="{StaticResource ToolboxItemStyle}"
                                    Tag="Image"
                                    MouseMove="ToolboxItem_MouseMove">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📷 "
                                            Foreground="#007ACC"
                                            FontWeight="Bold"/>
                                    <TextBlock Text="Image Source"
                                            Foreground="#CCCCCC"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Style="{StaticResource ToolboxItemStyle}"
                                    Tag="Line"
                                    MouseMove="ToolboxItem_MouseMove">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➖ "
                                            Foreground="#D4AF37"
                                            FontWeight="Bold"/>
                                    <TextBlock Text="Separator Line"
                                            Foreground="#CCCCCC"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <Border Background="#1E1E1E"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,15,0,0"
                                BorderBrush="#3E3E42"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Quick Actions:"
                                        FontWeight="SemiBold"
                                        Foreground="#007ACC"
                                        FontSize="11"
                                        Margin="0,0,0,5"/>
                                <Button Content="➕ Add TextBlock"
                                        Command="{Binding AddComponentCommand}"
                                        CommandParameter="Text"
                                        Padding="6,4"
                                        Margin="0,0,0,5"
                                        Background="#2D2D30"
                                        Foreground="#CCCCCC"
                                        BorderBrush="#3E3E42"/>
                                <Button Content="➕ Add Image"
                                        Command="{Binding AddComponentCommand}"
                                        CommandParameter="Image"
                                        Padding="6,4"
                                        Margin="0,0,0,5"
                                        Background="#2D2D30"
                                        Foreground="#CCCCCC"
                                        BorderBrush="#3E3E42"/>
                                <Button Content="➕ Add Line"
                                        Command="{Binding AddComponentCommand}"
                                        CommandParameter="Line"
                                        Padding="6,4"
                                        Background="#2D2D30"
                                        Foreground="#CCCCCC"
                                        BorderBrush="#3E3E42"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="#1E1E1E"
                ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2"
                Background="#1E1E1E">
            <TabControl Background="Transparent"
                    BorderThickness="0"
                    Margin="0"
                    x:Name="MainTabs">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                            Margin="12,5"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background"
                                Value="#2D2D30"/>
                        <Setter Property="Foreground"
                                Value="#CCCCCC"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderThickness="0,2,0,0"
                                            BorderBrush="Transparent"
                                            Margin="0,0,1,0">
                                        <ContentPresenter x:Name="ContentSite"
                                                ContentSource="Header"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected"
                                                Value="True">
                                            <Setter Property="Background"
                                                    Value="#1E1E1E"/>
                                            <Setter Property="Foreground"
                                                    Value="White"/>
                                            <Setter TargetName="TabBorder"
                                                    Property="BorderBrush"
                                                    Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver"
                                                Value="True">
                                            <Setter Property="Background"
                                                    Value="#3E3E42"/>
                                            <Setter Property="Foreground"
                                                    Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="📐 Report Designer"
                        x:Name="DesignTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#2D2D30"
                                BorderBrush="#3E3E42"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="50,0,0,0">
                                    <TextBlock Text="0px"
                                            Foreground="#808080"
                                            FontSize="9"
                                            Width="100"/>
                                    <TextBlock Text="100px"
                                            Foreground="#808080"
                                            FontSize="9"
                                            Width="100"/>
                                    <TextBlock Text="200px"
                                            Foreground="#808080"
                                            FontSize="9"
                                            Width="100"/>
                                    <TextBlock Text="300px"
                                            Foreground="#808080"
                                            FontSize="9"
                                            Width="100"/>
                                    <TextBlock Text="400px"
                                            Foreground="#808080"
                                            FontSize="9"
                                            Width="100"/>
                                    <TextBlock Text="500px"
                                            Foreground="#808080"
                                            FontSize="9"
                                            Width="100"/>
                                    <TextBlock Text="600px"
                                            Foreground="#808080"
                                            FontSize="9"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                Background="#1E1E1E">
                            <Grid Margin="30">
                                <Border Background="#1E1E1E"
                                        BorderBrush="#3E3E42"
                                        BorderThickness="1"
                                        Width="794"
                                        Height="1123"
                                        SnapsToDevicePixels="True"
                                        CornerRadius="2"
                                        x:Name="CanvasSurface">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black"
                                                BlurRadius="15"
                                                Opacity="0.25"
                                                ShadowDepth="4"
                                                Direction="270"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.Background>
                                            <DrawingBrush TileMode="Tile"
                                                    Viewport="0,0,16,16"
                                                    ViewportUnits="Absolute">
                                                <DrawingBrush.Drawing>
                                                    <GeometryDrawing>
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <LineGeometry StartPoint="0,0"
                                                                        EndPoint="16,0"/>
                                                                <LineGeometry StartPoint="0,0"
                                                                        EndPoint="0,16"/>
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                        <GeometryDrawing.Pen>
                                                            <Pen Brush="#2D2D30"
                                                                    Thickness="0.5"/>
                                                        </GeometryDrawing.Pen>
                                                    </GeometryDrawing>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Grid.Background>

                                        <ListBox x:Name="DesignerCanvas"
                                                 ItemsSource="{Binding CanvasComponents}"
                                                 SelectedItem="{Binding SelectedComponent}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 AllowDrop="True"
                                                 DragEnter="Canvas_DragEnter"
                                                 DragOver="Canvas_DragOver"
                                                 Drop="Canvas_Drop"
                                                 PreviewKeyDown="Canvas_PreviewKeyDown">

                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Background="Transparent"
                                                            IsItemsHost="True"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Canvas.Left"
                                                            Value="{Binding X, Mode=TwoWay}"/>
                                                    <Setter Property="Canvas.Top"
                                                            Value="{Binding Y, Mode=TwoWay}"/>
                                                    <Setter Property="Panel.ZIndex"
                                                            Value="{Binding ZIndex}"/>
                                                    <Setter Property="HorizontalContentAlignment"
                                                            Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment"
                                                            Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Grid>
                                                                    <Border x:Name="ItemBorder"
                                                                            BorderThickness="1"
                                                                            BorderBrush="Transparent"
                                                                            Background="Transparent"
                                                                            Padding="1"
                                                                            MouseDown="CanvasItem_MouseDown">
                                                                        <ContentPresenter/>
                                                                    </Border>

                                                                    <Canvas x:Name="SelectionAdorners"
                                                                            Visibility="Collapsed"
                                                                            IsHitTestVisible="True">
                                                                        <Rectangle Stroke="#007ACC"
                                                                                StrokeDashArray="3 2"
                                                                                StrokeThickness="1"
                                                                                   Width="{Binding Width}"
                                                                                Height="{Binding Height}"
                                                                                Margin="1"/>

                                                                        <Border Background="#007ACC"
                                                                                CornerRadius="1"
                                                                                Padding="3,1"
                                                                                Canvas.Top="-18"
                                                                                Canvas.Left="0">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="X:"
                                                                                        Foreground="#99FFFFFF"
                                                                                        FontSize="8"
                                                                                        FontWeight="Bold"/>
                                                                                <TextBlock Text="{Binding X, StringFormat={}{0:F0}}"
                                                                                        Foreground="White"
                                                                                        FontSize="8"
                                                                                        Margin="1,0,4,0"/>
                                                                                <TextBlock Text="Y:"
                                                                                        Foreground="#99FFFFFF"
                                                                                        FontSize="8"
                                                                                        FontWeight="Bold"/>
                                                                                <TextBlock Text="{Binding Y, StringFormat={}{0:F0}}"
                                                                                        Foreground="White"
                                                                                        FontSize="8"
                                                                                        Margin="1,0,4,0"/>
                                                                                <TextBlock Text="W:"
                                                                                        Foreground="#99FFFFFF"
                                                                                        FontSize="8"
                                                                                        FontWeight="Bold"/>
                                                                                <TextBlock Text="{Binding Width, StringFormat={}{0:F0}}"
                                                                                        Foreground="White"
                                                                                        FontSize="8"
                                                                                        Margin="1,0,4,0"/>
                                                                                <TextBlock Text="H:"
                                                                                        Foreground="#99FFFFFF"
                                                                                        FontSize="8"
                                                                                        FontWeight="Bold"/>
                                                                                <TextBlock Text="{Binding Height, StringFormat={}{0:F0}}"
                                                                                        Foreground="White"
                                                                                        FontSize="8"/>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <Thumb x:Name="ResizeHandleSE"
                                                                               Width="7"
                                                                                Height="7"
                                                                               Background="#007ACC"
                                                                               BorderBrush="White"
                                                                               BorderThickness="1"
                                                                               Cursor="SizeNWSE"
                                                                               Canvas.Left="{Binding Width}"
                                                                               Canvas.Top="{Binding Height}"
                                                                               DragDelta="ResizeHandle_DragDelta"/>
                                                                    </Canvas>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected"
                                                                            Value="True">
                                                                        <Setter TargetName="SelectionAdorners"
                                                                                Property="Visibility"
                                                                                Value="Visible"/>
                                                                        <Setter TargetName="ItemBorder"
                                                                                Property="BorderBrush"
                                                                                Value="#007ACC"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="📄 Print Layout Preview"
                        x:Name="PreviewTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#2D2D30"
                                BorderBrush="#3E3E42"
                                BorderThickness="0,0,0,1"
                                Padding="15,6">
                            <Grid>
                                <TextBlock Text="📄 This is a high-fidelity rendering of your compiled layout. All handles and grid indicators are removed."
                                        Foreground="#808080"
                                        FontSize="11"
                                        VerticalAlignment="Center"/>
                                <Button Content="🖨️ Export PDF / Print Layout"
                                        HorizontalAlignment="Right"
                                        Padding="10,4"
                                        Background="#007ACC"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="PrintReport_Click"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                Background="#1E1E1E"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                            <Grid Margin="30">
                                <Border Background="White"
                                        BorderBrush="#3E3E42"
                                        BorderThickness="1"
                                        Width="794"
                                        Height="1123"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black"
                                                BlurRadius="15"
                                                Opacity="0.5"
                                                ShadowDepth="4"
                                                Direction="270"/>
                                    </Border.Effect>
                                    <ItemsControl ItemsSource="{Binding CanvasComponents}"
                                            IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Background="Transparent"
                                                        IsItemsHost="True"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left"
                                                        Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top"
                                                        Value="{Binding Y}"/>
                                                <Setter Property="Panel.ZIndex"
                                                        Value="{Binding ZIndex}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>

                                        <ItemsControl.Resources>
                                            <DataTemplate DataType="{x:Type models:TextComponent}">
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="{Binding FontSize}"
                                                           FontFamily="{Binding FontFamily}"
                                                           Foreground="Black"
                                                           Width="{Binding Width}"
                                                           Height="{Binding Height}"
                                                           TextWrapping="Wrap"/>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type models:ImageComponent}">
                                                <Grid Width="{Binding Width}"
                                                        Height="{Binding Height}">
                                                    <Image Source="{Binding SourcePath, TargetNullValue={x:Null}}"
                                                            Stretch="Uniform"/>
                                                </Grid>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type models:LineComponent}">
                                                <Grid Width="{Binding Width}"
                                                        Height="{Binding Height}">
                                                    <Rectangle Fill="Black"
                                                            Height="1.5"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Stretch"
                                                            x:Name="HLine"/>
                                                    <Rectangle Fill="Black"
                                                            Width="1.5"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Stretch"
                                                            x:Name="VLine"
                                                            Visibility="Collapsed"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Orientation}"
                                                            Value="Vertical">
                                                        <Setter TargetName="HLine"
                                                                Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Setter TargetName="VLine"
                                                                Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.Resources>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <GridSplitter Grid.Column="3"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="#1E1E1E"
                ResizeBehavior="PreviousAndNext"/>

        <Border Grid.Column="4"
                Background="#2D2D30"
                BorderBrush="#1E1E1E"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#3E3E42"
                        Padding="10,8"
                        BorderBrush="#1E1E1E"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                            <TextBlock Text="⚙️"
                                    FontSize="13"
                                    Margin="0,0,6,0"/>
                            <TextBlock Text="PROPERTIES GRID"
                                    FontWeight="Bold"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Foreground="#CCCCCC"/>
                        </StackPanel>
                        <Border x:Name="TypeBadgeBorder"
                                HorizontalAlignment="Right"
                                Background="#1E1E1E"
                                BorderBrush="#3E3E42"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="4,1"
                                Visibility="Collapsed">
                            <TextBlock Text="COMPONENT"
                                    FontSize="8"
                                    FontFamily="Consolas"
                                    Foreground="#007ACC"
                                    FontWeight="Bold"
                                    x:Name="TypeBadgeText"/>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        Margin="10">
                    <Grid>
                        <StackPanel x:Name="NoSelectionPlaceholder"
                                Margin="20,40,20,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextBlock.TextAlignment="Center">
                            <TextBlock Text="❓"
                                    FontSize="28"
                                    Foreground="#555555"
                                    Margin="0,0,0,10"/>
                            <TextBlock Text="No Selection"
                                    FontWeight="Bold"
                                    Foreground="#CCCCCC"
                                    Margin="0,0,0,4"/>
                            <TextBlock Text="Click on any element in the design canvas to configure its dimensions, position, and specific properties."
                                       Foreground="#808080"
                                    FontSize="10"
                                    TextWrapping="Wrap"
                                    LineHeight="14"/>
                        </StackPanel>

                        <Grid x:Name="PropertiesForm"
                                DataContext="{Binding SelectedComponent}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Border BorderBrush="#3E3E42"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,0,0,12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="LAYOUT (WPF CANVAS)"
                                                Foreground="#808080"
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Canvas.Left (X)"
                                                    Foreground="#CCCCCC"
                                                    VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1"
                                                    Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Background="#1E1E1E"
                                                    Foreground="White"
                                                    BorderBrush="#3E3E42"
                                                    Padding="4,2"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Canvas.Top (Y)"
                                                    Foreground="#CCCCCC"
                                                    VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1"
                                                    Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Background="#1E1E1E"
                                                    Foreground="White"
                                                    BorderBrush="#3E3E42"
                                                    Padding="4,2"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Width (px)"
                                                    Foreground="#CCCCCC"
                                                    VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1"
                                                    Text="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Background="#1E1E1E"
                                                    Foreground="White"
                                                    BorderBrush="#3E3E42"
                                                    Padding="4,2"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Height (px)"
                                                    Foreground="#CCCCCC"
                                                    VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1"
                                                    Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Background="#1E1E1E"
                                                    Foreground="White"
                                                    BorderBrush="#3E3E42"
                                                    Padding="4,2"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Z-Index Layer"
                                                    Foreground="#CCCCCC"
                                                    VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1"
                                                    Text="{Binding ZIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Background="#1E1E1E"
                                                    Foreground="White"
                                                    BorderBrush="#3E3E42"
                                                    Padding="4,2"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="SPECIFIC PROPERTIES"
                                        Foreground="#808080"
                                        FontSize="9"
                                        FontWeight="Bold"
                                        Margin="0,0,0,10"/>
                                <ContentControl Content="{Binding}">
                                    <ContentControl.Resources>
                                        <DataTemplate DataType="{x:Type models:TextComponent}">
                                            <StackPanel>
                                                <TextBlock Text="Label Text / Expression"
                                                        Foreground="#CCCCCC"
                                                        Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        AcceptsReturn="True"
                                                        TextWrapping="Wrap"
                                                        Height="60"
                                                        VerticalScrollBarVisibility="Auto"
                                                        Background="#1E1E1E"
                                                        Foreground="White"
                                                        BorderBrush="#3E3E42"
                                                        Padding="4"
                                                        Margin="0,0,0,10"/>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Font Size (pt)"
                                                            Foreground="#CCCCCC"
                                                            VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Background="#1E1E1E"
                                                            Foreground="White"
                                                            BorderBrush="#3E3E42"
                                                            Padding="4,2"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Font Family"
                                                            Foreground="#CCCCCC"
                                                            VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1"
                                                            SelectedValue="{Binding FontFamily, Mode=TwoWay}"
                                                            SelectedValuePath="Content"
                                                            Background="#2D2D30"
                                                            Foreground="White"
                                                            BorderBrush="#3E3E42">
                                                        <ComboBoxItem Content="Segoe UI"/>
                                                        <ComboBoxItem Content="Arial"/>
                                                        <ComboBoxItem Content="Times New Roman"/>
                                                        <ComboBoxItem Content="Courier New"/>
                                                        <ComboBoxItem Content="Consolas"/>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>

                                        <DataTemplate DataType="{x:Type models:ImageComponent}">
                                            <StackPanel>
                                                <TextBlock Text="Source Path (Local / URL)"
                                                        Foreground="#CCCCCC"
                                                        Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        TextWrapping="Wrap"
                                                        Height="50"
                                                        VerticalScrollBarVisibility="Auto"
                                                        Background="#1E1E1E"
                                                        Foreground="White"
                                                        BorderBrush="#3E3E42"
                                                        Padding="4"
                                                        Margin="0,0,0,10"/>
                                                <TextBlock Text="e.g. C:\Assets\logo.png or http://..."
                                                        Foreground="#808080"
                                                        FontSize="9"/>
                                            </StackPanel>
                                        </DataTemplate>

                                        <DataTemplate DataType="{x:Type models:LineComponent}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Line Length"
                                                            Foreground="#CCCCCC"
                                                            VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1"
                                                            Text="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Background="#1E1E1E"
                                                            Foreground="White"
                                                            BorderBrush="#3E3E42"
                                                            Padding="4,2"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Orientation"
                                                            Foreground="#CCCCCC"
                                                            VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1"
                                                            SelectedValue="{Binding Orientation, Mode=TwoWay}"
                                                            SelectedValuePath="Content"
                                                            Background="#2D2D30"
                                                            Foreground="White"
                                                            BorderBrush="#3E3E42">
                                                        <ComboBoxItem Content="Horizontal"/>
                                                        <ComboBoxItem Content="Vertical"/>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.Resources>
                                </ContentControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="FooterKeyboardGuide"
                        Grid.Row="2"
                        Background="#2D2D30"
                        BorderBrush="#1E1E1E"
                        BorderThickness="0,1,0,0"
                        Padding="10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="KEYBOARD ACTIONS:"
                                FontWeight="Bold"
                                FontSize="9"
                                Foreground="#808080"
                                Margin="0,0,0,4"/>
                        <TextBlock Text="• Drag element inside borders to reposition"
                                FontSize="9"
                                Foreground="#808080"/>
                        <TextBlock Text="• Drag blue corner handle to resize"
                                FontSize="9"
                                Foreground="#808080"/>
                        <Button Content="🗑️ Delete Component"
                                Command="{Binding DataContext.DeleteComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="6,4"
                                Background="#7F1D1D"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,8,0,0"
                                FontWeight="SemiBold"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>