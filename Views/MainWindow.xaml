<Window x:Class="AutoReportWizard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:System.Windows.Controls"
        xmlns:local="clr-namespace:AutoReportWizard"
        Title="AutoReport Wizard"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        BorderThickness="0">

    <Window.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        
        <!-- Style template for the stepper dots -->
        <Style x:Key="StepperDotStyle" TargetType="Border">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.25"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        
        <!-- Style template for the stepper connectors -->
        <Style x:Key="StepperConnectorStyle" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.2"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Web-App Style Root Layout (No Margins, Full Bleed) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Full-Bleed Header -->
            <RowDefinition Height="*"/>    <!-- Dynamic Main Content -->
        </Grid.RowDefinitions>

        <!-- Hidden State Holders for Code-Behind Compatibility -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="Icon1" Text="□"/> <TextBlock x:Name="Text1"/>
            <TextBlock x:Name="Icon2" Text="□"/> <TextBlock x:Name="Text2"/>
            <TextBlock x:Name="Icon3" Text="□"/> <TextBlock x:Name="Text3"/>
            <TextBlock x:Name="Icon4" Text="□"/> <TextBlock x:Name="Text4"/>
            <TextBlock x:Name="Icon5" Text="□"/> <TextBlock x:Name="Text5"/>
            <TextBlock x:Name="Icon6" Text="□"/> <TextBlock x:Name="Text6"/>
        </StackPanel>

        <!-- 1. WEB-STYLE HEADER (Top Bar, Stepper & Navigation) -->
        <Border Grid.Row="0" 
                Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="#1A1A1A" 
                BorderThickness="0,0,0,1" 
                Padding="32,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Header / Connection Info -->
                <Button Grid.Column="0" 
                        Style="{StaticResource DarkBtn}"
                        Padding="12,8"
                        ToolTip="Change Connection"
                        Click="ChangeConnection_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙️" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="Target DB" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DatabaseName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="150" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- The Avant-Garde Stepper -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource StepperDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Icon1}" Value="■"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="8"/><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="Opacity" Value="1"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#7C3AED" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding Text, ElementName=Icon1}" Value="✓"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Opacity" Value="0.8"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                    <Border Style="{StaticResource StepperConnectorStyle}"/>
                    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource StepperDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Icon2}" Value="■"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="8"/><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="Opacity" Value="1"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#7C3AED" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding Text, ElementName=Icon2}" Value="✓"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Opacity" Value="0.8"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                    <Border Style="{StaticResource StepperConnectorStyle}"/>
                    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource StepperDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Icon3}" Value="■"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="8"/><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="Opacity" Value="1"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#7C3AED" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding Text, ElementName=Icon3}" Value="✓"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Opacity" Value="0.8"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                    <Border Style="{StaticResource StepperConnectorStyle}"/>
                    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource StepperDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Icon4}" Value="■"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="8"/><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="Opacity" Value="1"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#7C3AED" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding Text, ElementName=Icon4}" Value="✓"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Opacity" Value="0.8"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                    <Border Style="{StaticResource StepperConnectorStyle}"/>
                    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource StepperDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Icon5}" Value="■"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="8"/><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="Opacity" Value="1"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#7C3AED" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding Text, ElementName=Icon5}" Value="✓"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Opacity" Value="0.8"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                    <Border Style="{StaticResource StepperConnectorStyle}"/>
                    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource StepperDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Icon6}" Value="■"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="8"/><Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="Opacity" Value="1"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#7C3AED" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding Text, ElementName=Icon6}" Value="✓"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Opacity" Value="0.8"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                </StackPanel>

                <!-- Navigation Controls relocated to Top Right -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Content="← Previous"
                            Width="120"
                            Style="{StaticResource DarkBtn}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Click="BackButton_Click"
                            Margin="0,0,12,0"/>

                    <Button x:Name="NextButton"
                            Content="Next →"
                            Width="120"
                            Style="{StaticResource NeoPillButton}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            Click="NextButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN DYNAMIC CONTENT AREA -->
        <Grid Grid.Row="1">
            <ContentControl x:Name="MainContentArea"/>

            <!-- Processing Overlay -->
            <Border Background="#B20F172A"
                    Panel.ZIndex="999"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="260" Height="4"
                                 Background="#1E293B"
                                 Foreground="{StaticResource AccentBrush}"
                                 Margin="0,0,0,16" BorderThickness="0"/>
                    <TextBlock Text="PROCESSING..."
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>