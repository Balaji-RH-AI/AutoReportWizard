<Window x:Class="AutoReportWizard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:System.Windows.Controls"
        xmlns:local="clr-namespace:AutoReportWizard"
        xmlns:views="clr-namespace:AutoReportWizard.Views"
        Title="AutoReport Wizard"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        BorderThickness="0">

    <Window.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        
        <Style x:Key="StepperDotStyle" TargetType="Border">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.25"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Active">
                    <Setter Property="Width" Value="24"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#7C3AED" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Completed">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="0.8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="StepperConnectorStyle" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.2"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="#1A1A1A" 
                BorderThickness="0,0,0,1" 
                Padding="32,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Style="{StaticResource DarkBtn}"
                        Padding="12,8"
                        ToolTip="Change Connection"
                        Command="{Binding ChangeConnectionCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙️" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="Target DB" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DatabaseName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="150" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Stepper UI bounded to CurrentStep (Skipping 3) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepperDotStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="1"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Tag" Value="Completed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Tag" Value="Completed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="5"><Setter Property="Tag" Value="Completed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6"><Setter Property="Tag" Value="Completed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Style="{StaticResource StepperConnectorStyle}"/>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepperDotStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Tag" Value="Completed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="5"><Setter Property="Tag" Value="Completed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6"><Setter Property="Tag" Value="Completed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Style="{StaticResource StepperConnectorStyle}"/>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepperDotStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="5"><Setter Property="Tag" Value="Completed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6"><Setter Property="Tag" Value="Completed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Style="{StaticResource StepperConnectorStyle}"/>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepperDotStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="5"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6"><Setter Property="Tag" Value="Completed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Style="{StaticResource StepperConnectorStyle}"/>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepperDotStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Content="← Previous"
                            Width="120"
                            Command="{Binding PreviousStepCommand}"
                            Margin="0,0,12,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="NextButton"
                            Width="120"
                            Command="{Binding NextStepCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NeoPillButton}">
                                <Setter Property="Content" Value="Next →"/>
                                <Setter Property="Command" Value="{Binding NextStepCommand}"/>
                                <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="6">
                                        <Setter Property="Content" Value="Finish ✓"/>
                                        <Setter Property="Command" Value="{Binding FinishCommand}"/>
                                        <Setter Property="Background" Value="#2E8B57"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid>
                <!-- 🔥 Step 3 is completely removed from the visual tree -->
                <views:Step1View Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}"/>
                <views:Step2View Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}"/>
                <views:Step4View Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}"/>
                <views:Step5View Visibility="{Binding IsStep5, Converter={StaticResource BoolToVis}}"/>
                <views:Step6View Visibility="{Binding IsStep6, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <Border Background="#B20F172A"
                    Panel.ZIndex="999"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="260" Height="4"
                                 Background="#1E293B"
                                 Foreground="{StaticResource AccentBrush}"
                                 Margin="0,0,0,16" BorderThickness="0"/>
                    <TextBlock Text="PROCESSING..."
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>