<UserControl x:Class="AutoReportWizard.Views.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoReportWizard"
             Background="Transparent">

    <UserControl.Resources>
        <local:InverseBoolConverter x:Key="InvBool"/>

        <Style x:Key="ColLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#888"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Margin"
                    Value="0,0,0,6"/>
        </Style>

        <Style x:Key="TypeBadge"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#252525"/>
            <Setter Property="CornerRadius"
                    Value="3"/>
            <Setter Property="Padding"
                    Value="5,2"/>
            <Setter Property="Margin"
                    Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Group By &amp; Aggregation"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"/>
            <TextBlock Foreground="Gray"
                       FontSize="13"
                       Margin="0,5,0,20"
                       TextWrapping="Wrap"
                       Text="Check GROUP BY on dimension fields. Pick an aggregate for numeric measures."/>

            <Grid Margin="10,0,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="FIELD"
                           Style="{StaticResource ColLabel}"/>
                <TextBlock Grid.Column="1"
                           Text="GROUP BY"
                           Style="{StaticResource ColLabel}"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="AGGREGATE"
                           Style="{StaticResource ColLabel}"
                           HorizontalAlignment="Center"/>
            </Grid>

            <Border Background="#1A1A1A"
                    BorderBrush="#333"
                    BorderThickness="1"
                    CornerRadius="6"
                    MaxHeight="380">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource TypeBadge}">
                                            <TextBlock Text="{Binding SqlDataType}"
                                                       Foreground="#888"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsGroupBy, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Checked="GroupByCheck_Changed"
                                              Unchecked="GroupByCheck_Changed"/>

                                    <ComboBox Grid.Column="2"
                                              x:Name="AggCombo"
                                              Tag="{Binding}"
                                              IsEnabled="{Binding IsGroupBy, Converter={StaticResource InvBool}}"
                                              Background="#0A0A0A"
                                              Foreground="White"
                                              BorderBrush="#444"
                                              FontSize="12"
                                              SelectionChanged="Agg_SelectionChanged"
                                              Loaded="AggCombo_Loaded"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Live SQL Editor"
                               Foreground="#D4AF37"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="#252525"
                        CornerRadius="4"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ManualModeToggle"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Checked="ManualMode_Changed"
                                  Unchecked="ManualMode_Changed"/>
                        <TextBlock Text="Manual SQL Mode"
                                   Foreground="#F0C040"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="4"
                        Content="Scaffold Base Query"
                        Background="#1A1A1A"
                        Foreground="#CCC"
                        BorderBrush="#444"
                        BorderThickness="1"
                        Padding="10,4"
                        Cursor="Hand"
                        Click="ScaffoldQuery_Click"/>

                <Button Grid.Column="6"
                        Content="Sync Output to Layout"
                        Background="#007ACC"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="10,4"
                        Cursor="Hand"
                        Click="ParseCustomSql_Click"/>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,0,0,10">
                <TextBlock Text="PRE-QUERY EXTENSIONS (Variables / Mapping Logic)"
                           Foreground="#D4AF37"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding PreQueryLogic, UpdateSourceTrigger=PropertyChanged}"
                         Background="#0D1117"
                         Foreground="#CE9178"
                         FontFamily="Consolas"
                         FontSize="12"
                         BorderBrush="#444"
                         BorderThickness="1"
                         Padding="10"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextChanged="PreviewText_Changed"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,10">
                <TextBlock Text="CUSTOM FILTERING (WHERE Clause Constraints)"
                           Foreground="#D4AF37"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding CustomWhereClause, UpdateSourceTrigger=PropertyChanged}"
                         Background="#0D1117"
                         Foreground="#CE9178"
                         FontFamily="Consolas"
                         FontSize="12"
                         BorderBrush="#444"
                         BorderThickness="1"
                         Padding="10"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextChanged="PreviewText_Changed"/>
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="LIVE STORED PROCEDURE PREVIEW"
                           Foreground="#D4AF37"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox Grid.Row="1"
                         x:Name="LiveSqlEditor"
                         Text="{Binding CustomSql, UpdateSourceTrigger=PropertyChanged}"
                         Background="#0D1117"
                         Foreground="#CE9178"
                         FontFamily="Consolas"
                         FontSize="13"
                         BorderBrush="#444"
                         BorderThickness="1"
                         Padding="14"
                         IsReadOnly="False"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius"
                                    Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>