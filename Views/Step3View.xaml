<UserControl x:Class="AutoReportWizard.Views.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoReportWizard"
             Background="Transparent">

    <UserControl.Resources>
        <local:InverseBoolConverter x:Key="InvBool"/>
        <Style x:Key="ColLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="TypeBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side: Fields -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Group By &amp; Aggregation"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="22" FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" TextWrapping="Wrap" Margin="0,0,0,24"
                       Text="Check GROUP BY on dimension fields. Pick an aggregate for numeric measures."/>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                <StackPanel>
                    <Grid Margin="12,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FIELD" Style="{StaticResource ColLabel}"/>
                        <TextBlock Grid.Column="1" Text="GROUP BY" Style="{StaticResource ColLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="AGGREGATE" Style="{StaticResource ColLabel}" HorizontalAlignment="Center"/>
                    </Grid>

                    <Border Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" MaxHeight="380">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="12,8" Margin="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1E293B"/> <!-- hover -->
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource TypeBadge}">
                                                        <TextBlock Text="{Binding SqlDataType}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>

                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsGroupBy, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="GroupByCheck_Changed" Unchecked="GroupByCheck_Changed"/>
                                                <ComboBox Grid.Column="2" x:Name="AggCombo" Tag="{Binding}" IsEnabled="{Binding IsGroupBy, Converter={StaticResource InvBool}}" SelectionChanged="Agg_SelectionChanged" Loaded="AggCombo_Loaded"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right Side: Editors -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Live SQL Editor" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <Border Grid.Column="2" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ManualModeToggle" VerticalAlignment="Center" Margin="0,0,8,0" Checked="ManualMode_Changed" Unchecked="ManualMode_Changed"/>
                        <TextBlock Text="Manual SQL Mode" Foreground="{StaticResource AccentGoldBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="4" Content="Scaffold Query" Style="{StaticResource DarkBtn}" Padding="16,8" Cursor="Hand" Click="ScaffoldQuery_Click"/>
                <Button Grid.Column="6" Content="Sync to Layout" Style="{StaticResource NeoPillButton}" Padding="16,8" Cursor="Hand" Click="ParseCustomSql_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="PRE-QUERY EXTENSIONS (VARIABLES / MAPPING LOGIC)" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,0,8"/>
                <Border Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <TextBox Text="{Binding PreQueryLogic, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#A78BFA" FontFamily="Consolas" FontSize="13" BorderThickness="0" Padding="16" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="PreviewText_Changed"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="CUSTOM FILTERING (WHERE CLAUSE)" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,0,8"/>
                <Border Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <TextBox Text="{Binding CustomWhereClause, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#A78BFA" FontFamily="Consolas" FontSize="13" BorderThickness="0" Padding="16" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="PreviewText_Changed"/>
                </Border>
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="LIVE STORED PROCEDURE PREVIEW" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <TextBox x:Name="LiveSqlEditor" Text="{Binding CustomSql, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#34D399" FontFamily="Consolas" FontSize="13" BorderThickness="0" Padding="16" IsReadOnly="False" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
