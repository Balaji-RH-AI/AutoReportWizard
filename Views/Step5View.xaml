<UserControl x:Class="AutoReportWizard.Views.Step5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoReportWizard.Views"
             xmlns:vm="clr-namespace:AutoReportWizard.ViewModels"
             Background="#0A0A0A">
        <UserControl.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>

                <Style x:Key="PropTextBox"
                                TargetType="TextBox">
                        <Setter Property="Background"
                                        Value="#1E1E1E"/>
                        <Setter Property="Foreground"
                                        Value="#EAEAEA"/>
                        <Setter Property="BorderBrush"
                                        Value="#3A3A3A"/>
                        <Setter Property="BorderThickness"
                                        Value="1"/>
                        <Setter Property="Padding"
                                        Value="5,4"/>
                        <Setter Property="CaretBrush"
                                        Value="#D4AF37"/>
                        <Setter Property="Margin"
                                        Value="0,0,0,10"/>
                        <Setter Property="FontSize"
                                        Value="12"/>
                        <Style.Triggers>
                                <Trigger Property="IsFocused"
                                                Value="True">
                                        <Setter Property="BorderBrush"
                                                        Value="#D4AF37"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>

                <Style x:Key="PropComboBox"
                                TargetType="ComboBox">
                        <Setter Property="Background"
                                        Value="#1E1E1E"/>
                        <Setter Property="Foreground"
                                        Value="#EAEAEA"/>
                        <Setter Property="BorderBrush"
                                        Value="#3A3A3A"/>
                        <Setter Property="BorderThickness"
                                        Value="1"/>
                        <Setter Property="Padding"
                                        Value="5,4"/>
                        <Setter Property="Margin"
                                        Value="0,0,0,10"/>
                </Style>

                <Style x:Key="PropCheckBox"
                                TargetType="CheckBox">
                        <Setter Property="Foreground"
                                        Value="#EAEAEA"/>
                        <Setter Property="Margin"
                                        Value="0,0,0,10"/>
                </Style>

                <Style x:Key="PropSectionHeader"
                                TargetType="TextBlock">
                        <Setter Property="Foreground"
                                        Value="#D4AF37"/>
                        <Setter Property="FontWeight"
                                        Value="Bold"/>
                        <Setter Property="FontSize"
                                        Value="11"/>
                        <Setter Property="Margin"
                                        Value="0,16,0,8"/>
                </Style>

                <Style x:Key="PropFieldLabel"
                                TargetType="TextBlock">
                        <Setter Property="Foreground"
                                        Value="#999999"/>
                        <Setter Property="FontSize"
                                        Value="10"/>
                        <Setter Property="Margin"
                                        Value="0,0,0,3"/>
                </Style>

                <Style x:Key="PropReadOnlyValue"
                                TargetType="TextBlock">
                        <Setter Property="Foreground"
                                        Value="#EAEAEA"/>
                        <Setter Property="FontSize"
                                        Value="12"/>
                        <Setter Property="Margin"
                                        Value="0,0,0,10"/>
                </Style>

                <Style x:Key="ColorSwatch"
                                TargetType="Border">
                        <Setter Property="Width"
                                        Value="24"/>
                        <Setter Property="Height"
                                        Value="24"/>
                        <Setter Property="CornerRadius"
                                        Value="3"/>
                        <Setter Property="BorderBrush"
                                        Value="#555555"/>
                        <Setter Property="BorderThickness"
                                        Value="1"/>
                        <Setter Property="Margin"
                                        Value="6,0,0,10"/>
                </Style>
        </UserControl.Resources>

        <Grid Margin="15">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOOLBAR -->
                <Border Grid.Row="0"
                                Background="#111111"
                                Padding="10"
                                Margin="0,0,0,10"
                                BorderBrush="#D4AF37"
                                BorderThickness="0,0,0,2">
                        <WrapPanel>
                                <Button Content="➕ Add New Field"
                                                Background="#333"
                                                Foreground="White"
                                                Padding="10,5"
                                                Margin="0,0,10,0"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="AddField_Click"/>
                                <Button Content="🗑 Remove Selected"
                                                Background="#522"
                                                Foreground="White"
                                                Padding="10,5"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="RemoveField_Click"/>
                                <TextBlock Text="🖱 Drag to move • Click to select • Drag corner handles to resize"
                                                Foreground="#888"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0"/>
                        </WrapPanel>
                </Border>

                <!-- MAIN WORKSPACE -->
                <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: The "Paper" (Header, Canvas, Footer) -->
                        <Grid Grid.Column="0"
                                        Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                                Background="White"
                                                Padding="20"
                                                BorderBrush="#D4AF37"
                                                BorderThickness="1,1,1,0"
                                                CornerRadius="4,4,0,0">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding HeaderSiteField, StringFormat='Site: {0}'}"
                                                                        FontWeight="Bold"
                                                                        FontSize="11"
                                                                        Foreground="Black"
                                                                        Margin="0,2"/>
                                                        <TextBlock Text="{Binding HeaderProcessDateField, StringFormat='Process: {0}'}"
                                                                        FontWeight="Bold"
                                                                        FontSize="11"
                                                                        Foreground="Black"
                                                                        Margin="0,2"/>
                                                        <TextBlock Text="{Binding HeaderJulianField, StringFormat='Julian: {0}'}"
                                                                        FontWeight="Bold"
                                                                        FontSize="11"
                                                                        Foreground="Black"
                                                                        Margin="0,2"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                                HorizontalAlignment="Center">
                                                        <TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        FontWeight="Bold"
                                                                        FontSize="20"
                                                                        TextAlignment="Center"
                                                                        Foreground="Black"/>
                                                        <TextBox Text="{Binding ReportSubtitle, UpdateSourceTrigger=PropertyChanged}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        FontSize="14"
                                                                        Foreground="#555"
                                                                        TextAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding HeaderWorksourceField, StringFormat='Worksource: {0}'}"
                                                                        FontWeight="Bold"
                                                                        FontSize="11"
                                                                        Foreground="Black"
                                                                        Margin="0,2"/>
                                                        <TextBlock Text="{Binding HeaderLoadField, StringFormat='Load: {0}'}"
                                                                        FontWeight="Bold"
                                                                        FontSize="11"
                                                                        Foreground="Black"
                                                                        Margin="0,2"/>
                                                        <TextBlock Text="Page: 1 / N"
                                                                        FontWeight="Bold"
                                                                        FontSize="11"
                                                                        Foreground="Black"
                                                                        Margin="0,2"/>
                                                </StackPanel>
                                        </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                                Background="#141414"
                                                BorderBrush="#D4AF37"
                                                BorderThickness="1,0,1,1"
                                                Padding="0">
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                        VerticalScrollBarVisibility="Auto">
                                                <Border Background="White"
                                                                Width="1100"
                                                                Height="420"
                                                                Margin="20"
                                                                MouseLeftButtonDown="DesignCanvasPaper_MouseLeftButtonDown">
                                                        <ItemsControl ItemsSource="{Binding Fields}">
                                                                <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                                <Canvas x:Name="DesignCanvas"
                                                                                                Background="Transparent"/>
                                                                        </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                                <Setter Property="Canvas.Left"
                                                                                                Value="{Binding CanvasX}"/>
                                                                                <Setter Property="Canvas.Top"
                                                                                                Value="{Binding CanvasY}"/>
                                                                        </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <local:DesignerFieldItem PreviewMouseLeftButtonDown="DesignerFieldItem_PreviewMouseLeftButtonDown"/>
                                                                        </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                </Border>
                                        </ScrollViewer>
                                </Border>

                                <Border Grid.Row="2"
                                                Background="White"
                                                Padding="15"
                                                CornerRadius="0,0,4,4"
                                                BorderBrush="#D4AF37"
                                                BorderThickness="1,0,1,1">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                                Text="{Binding CurrentPreviewTime, Mode=OneWay, StringFormat='Execution: {0}'}"
                                                                Foreground="#888"
                                                                FontSize="11"
                                                                HorizontalAlignment="Left"
                                                                Visibility="{Binding IncludeExecutionTime, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Grid.Column="1"
                                                                Text="Page 1 of N"
                                                                Foreground="#888"
                                                                FontSize="11"
                                                                HorizontalAlignment="Right"
                                                                Visibility="{Binding IncludePageNumbers, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                </Border>
                        </Grid>

                        <!-- RIGHT: Collapsible Properties Sidebar -->
                        <Grid Grid.Column="1"
                                        HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Vertical Tab Button -->
                                <ToggleButton x:Name="PropToggle"
                                                Grid.Column="0"
                                                IsChecked="True"
                                                Width="30"
                                                Height="100"
                                                VerticalAlignment="Top"
                                                Margin="0,20,0,0"
                                                Background="#1E1E1E"
                                                BorderBrush="#D4AF37"
                                                BorderThickness="1,1,0,1"
                                                Cursor="Hand">
                                        <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4,0,0,4">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                        </Border>
                                                </ControlTemplate>
                                        </ToggleButton.Template>
                                        <TextBlock Text="Properties"
                                                        Foreground="White"
                                                        FontWeight="Bold"
                                                        FontSize="13">
                                                <TextBlock.LayoutTransform>
                                                        <RotateTransform Angle="-90"/>
                                                </TextBlock.LayoutTransform>
                                        </TextBlock>
                                </ToggleButton>

                                <!-- Sidebar Content -->
                                <Border Grid.Column="1"
                                                Width="300"
                                                Background="#1E1E1E"
                                                BorderBrush="#D4AF37"
                                                BorderThickness="1"
                                                CornerRadius="0,4,4,4"
                                                Visibility="{Binding IsChecked, ElementName=PropToggle, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                                <TextBlock Text="Select a field on the canvas to edit its properties."
                                                                Foreground="#777"
                                                                FontStyle="Italic"
                                                                FontSize="12"
                                                                TextWrapping="Wrap"
                                                                Margin="16">
                                                        <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility"
                                                                                        Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SelectedField}"
                                                                                                Value="{x:Null}">
                                                                                        <Setter Property="Visibility"
                                                                                                        Value="Visible"/>
                                                                                </DataTrigger>
                                                                        </Style.Triggers>
                                                                </Style>
                                                        </TextBlock.Style>
                                                </TextBlock>

                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <ScrollViewer.Style>
                                                                <Style TargetType="ScrollViewer">
                                                                        <Setter Property="Visibility"
                                                                                        Value="Visible"/>
                                                                        <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SelectedField}"
                                                                                                Value="{x:Null}">
                                                                                        <Setter Property="Visibility"
                                                                                                        Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                        </Style.Triggers>
                                                                </Style>
                                                        </ScrollViewer.Style>
                                                        <StackPanel DataContext="{Binding SelectedField}"
                                                                        Margin="15">
                                                                <TextBlock Text="FIELD"
                                                                                Style="{StaticResource PropSectionHeader}"
                                                                                Margin="0,0,0,8"/>
                                                                <TextBlock Text="{Binding Name}"
                                                                                FontWeight="Bold"
                                                                                FontSize="14"
                                                                                Foreground="#D4AF37"
                                                                                Margin="0,0,0,12"/>

                                                                <TextBlock Text="Header Label"
                                                                                Style="{StaticResource PropFieldLabel}"/>
                                                                <TextBox Text="{Binding CustomHeaderLabel, UpdateSourceTrigger=PropertyChanged}"
                                                                                Style="{StaticResource PropTextBox}"/>

                                                                <TextBlock Text="SQL Data Type"
                                                                                Style="{StaticResource PropFieldLabel}"/>
                                                                <TextBlock Text="{Binding SqlDataType}"
                                                                                Style="{StaticResource PropReadOnlyValue}"/>

                                                                <TextBlock Text="Aggregate"
                                                                                Style="{StaticResource PropFieldLabel}"/>
                                                                <ComboBox ItemsSource="{Binding Source={x:Static vm:WizardViewModel.AggregateFunctions}}"
                                                                                SelectedItem="{Binding Aggregate, UpdateSourceTrigger=PropertyChanged}"
                                                                                Style="{StaticResource PropComboBox}"/>

                                                                <CheckBox Content="Group By"
                                                                                IsChecked="{Binding IsGroupBy}"
                                                                                Style="{StaticResource PropCheckBox}"/>
                                                                <CheckBox Content="Include in Layout"
                                                                                IsChecked="{Binding IsDetailField}"
                                                                                Style="{StaticResource PropCheckBox}"/>

                                                                <TextBlock Text="LAYOUT"
                                                                                Style="{StaticResource PropSectionHeader}"/>
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0"
                                                                                        Margin="0,0,4,0">
                                                                                <TextBlock Text="X (px)"
                                                                                                Style="{StaticResource PropFieldLabel}"/>
                                                                                <TextBox Text="{Binding CanvasX, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"
                                                                                                Style="{StaticResource PropTextBox}"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1"
                                                                                        Margin="4,0,0,0">
                                                                                <TextBlock Text="Y (px)"
                                                                                                Style="{StaticResource PropFieldLabel}"/>
                                                                                <TextBox Text="{Binding CanvasY, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"
                                                                                                Style="{StaticResource PropTextBox}"/>
                                                                        </StackPanel>
                                                                </Grid>
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0"
                                                                                        Margin="0,0,4,0">
                                                                                <TextBlock Text="Width (px)"
                                                                                                Style="{StaticResource PropFieldLabel}"/>
                                                                                <TextBox Text="{Binding ItemWidth, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"
                                                                                                Style="{StaticResource PropTextBox}"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1"
                                                                                        Margin="4,0,0,0">
                                                                                <TextBlock Text="Height (px)"
                                                                                                Style="{StaticResource PropFieldLabel}"/>
                                                                                <TextBox Text="{Binding ItemHeight, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"
                                                                                                Style="{StaticResource PropTextBox}"/>
                                                                        </StackPanel>
                                                                </Grid>

                                                                <TextBlock Text="APPEARANCE"
                                                                                Style="{StaticResource PropSectionHeader}"/>
                                                                <TextBlock Text="Text Align"
                                                                                Style="{StaticResource PropFieldLabel}"/>
                                                                <ComboBox ItemsSource="{Binding Source={x:Static vm:WizardViewModel.TextAlignOptions}}"
                                                                                SelectedItem="{Binding TextAlign, UpdateSourceTrigger=PropertyChanged}"
                                                                                Style="{StaticResource PropComboBox}"/>

                                                                <TextBlock Text="Font Weight"
                                                                                Style="{StaticResource PropFieldLabel}"/>
                                                                <ComboBox ItemsSource="{Binding Source={x:Static vm:WizardViewModel.FontWeightOptions}}"
                                                                                SelectedItem="{Binding FontWeight, UpdateSourceTrigger=PropertyChanged}"
                                                                                Style="{StaticResource PropComboBox}"/>

                                                                <TextBlock Text="Border Color"
                                                                                Style="{StaticResource PropFieldLabel}"/>
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Grid.Column="0"
                                                                                        Text="{Binding BorderColor, UpdateSourceTrigger=PropertyChanged}"
                                                                                        Style="{StaticResource PropTextBox}"/>
                                                                        <Border Grid.Column="1"
                                                                                        Background="{Binding BorderColor}"
                                                                                        Style="{StaticResource ColorSwatch}"/>
                                                                </Grid>

                                                                <TextBlock Text="Background Color"
                                                                                Style="{StaticResource PropFieldLabel}"/>
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Grid.Column="0"
                                                                                        Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                                                                        Style="{StaticResource PropTextBox}"/>
                                                                        <Border Grid.Column="1"
                                                                                        Background="{Binding BackgroundColor}"
                                                                                        Style="{StaticResource ColorSwatch}"/>
                                                                </Grid>

                                                                <TextBlock Text="DATA BINDING"
                                                                                Style="{StaticResource PropSectionHeader}"/>
                                                                <TextBlock Text="Custom Expression"
                                                                                Style="{StaticResource PropFieldLabel}"
                                                                                TextWrapping="Wrap"/>
                                                                <TextBox Text="{Binding CustomExpression, UpdateSourceTrigger=PropertyChanged}"
                                                                                Style="{StaticResource PropTextBox}"
                                                                                AcceptsReturn="True"
                                                                                TextWrapping="Wrap"
                                                                                MinHeight="54"
                                                                                MaxHeight="140"
                                                                                VerticalScrollBarVisibility="Auto"
                                                                                FontFamily="Consolas"/>
                                                        </StackPanel>
                                                </ScrollViewer>
                                        </Grid>
                                </Border>
                        </Grid>
                </Grid>
        </Grid>
</UserControl>