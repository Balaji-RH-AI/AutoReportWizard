<UserControl x:Class="AutoReportWizard.Views.Step5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2D2D30">
        <UserControl.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </UserControl.Resources>

        <Grid Margin="15">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#111"
                        Padding="10"
                        Margin="0,0,0,10"
                        BorderBrush="#444"
                        BorderThickness="1">
                        <WrapPanel>
                                <Button Content="➕ Add New Field"
                                        Style="{StaticResource DesignerBtn}"
                                        Click="AddField_Click"/>
                                <Button Content="🗑 Remove Selected"
                                        Style="{StaticResource DesignerBtn}"
                                        Click="RemoveField_Click"/>
                                <TextBlock Text="⇅ Drag rows to reorder"
                                           Foreground="#888"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                        </WrapPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="White"
                        Padding="20"
                        CornerRadius="4,4,0,0">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding HeaderSiteField, StringFormat='Site: {0}'}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Foreground="Black"
                                                   Margin="0,2"/>
                                        <TextBlock Text="{Binding HeaderProcessDateField, StringFormat='Process: {0}'}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Foreground="Black"
                                                   Margin="0,2"/>
                                        <TextBlock Text="{Binding HeaderJulianField, StringFormat='Julian: {0}'}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Foreground="Black"
                                                   Margin="0,2"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Center">
                                        <TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontWeight="Bold"
                                                 FontSize="20"
                                                 TextAlignment="Center"
                                                 Foreground="Black"/>
                                        <TextBox Text="{Binding ReportSubtitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="14"
                                                 Foreground="#555"
                                                 TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding HeaderWorksourceField, StringFormat='Worksource: {0}'}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Foreground="Black"
                                                   Margin="0,2"/>
                                        <TextBlock Text="{Binding HeaderLoadField, StringFormat='Load: {0}'}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Foreground="Black"
                                                   Margin="0,2"/>
                                        <TextBlock Text="Page: 1 / N"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Foreground="Black"
                                                   Margin="0,2"/>
                                </StackPanel>
                        </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#CCC"
                        BorderThickness="1,0,1,0"
                        Padding="0">
                        <DataGrid x:Name="LayoutGrid"
                                  ItemsSource="{Binding Fields}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F9F9F9"
                                  Foreground="Black"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="LayoutGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="LayoutGrid_PreviewMouseMove"
                                  Drop="LayoutGrid_Drop"
                                  DragOver="LayoutGrid_DragOver">
                                <DataGrid.Columns>
                                        <DataGridTextColumn Header="Data Field"
                                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="2*"/>
                                        <DataGridTextColumn Header="SQL Data Type"
                                                            Binding="{Binding SqlDataType}"
                                                            Width="*"
                                                            IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Order"
                                                            Binding="{Binding DisplayOrder}"
                                                            Width="60"
                                                            IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="Include in Layout"
                                                                Binding="{Binding IsDetailField, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="120"/>
                                </DataGrid.Columns>
                        </DataGrid>
                </Border>

                <Border Grid.Row="3"
                        Background="White"
                        Padding="15"
                        CornerRadius="0,0,4,4"
                        BorderBrush="#CCC"
                        BorderThickness="1">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding CurrentPreviewTime, Mode=OneWay, StringFormat='Execution: {0}'}"
                                           Foreground="#888"
                                           FontSize="11"
                                           HorizontalAlignment="Left"
                                           Visibility="{Binding IncludeExecutionTime, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Grid.Column="1"
                                           Text="Page 1 of N"
                                           Foreground="#888"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           Visibility="{Binding IncludePageNumbers, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                </Border>
        </Grid>
</UserControl>