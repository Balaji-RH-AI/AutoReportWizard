<UserControl x:Class="AutoReportWizard.Views.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoReportWizard"
             xmlns:models="clr-namespace:AutoReportWizard.Models"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32">
            <StackPanel Width="480" HorizontalAlignment="Center">
                
                <TextBlock Text="Target Environment"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Select the environment where your report will be generated."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <!-- Floating Sub-Card for Server & Auth -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="24"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Server Instance -->
                        <TextBlock Text="SQL SERVER INSTANCE"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" FontWeight="Medium"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="ServerTextBox"
                                 Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,24"/>

                        <!-- Authentication Policy -->
                        <TextBlock Text="AUTHENTICATION POLICY"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" FontWeight="Medium"
                                   Margin="0,0,0,8"/>
                        <ComboBox SelectedValue="{Binding AuthType}"
                                  SelectedValuePath="Tag"
                                  Margin="0,0,0,12">
                            <ComboBoxItem Content="Windows Authentication"
                                          Tag="{x:Static models:AuthenticationType.Windows}"/>
                            <ComboBoxItem Content="SQL Server Authentication"
                                          Tag="{x:Static models:AuthenticationType.SqlServer}"/>
                        </ComboBox>

                        <!-- Dynamic Auth Fields -->
                        <StackPanel Visibility="{Binding IsSqlAuth, Converter={StaticResource BoolToVis}}"
                                    Margin="0,12,0,0">
                            <TextBlock Text="USERNAME"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" FontWeight="Medium"
                                       Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,24"/>

                            <TextBlock Text="PASSWORD"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" FontWeight="Medium"
                                       Margin="0,0,0,8"/>
                            <PasswordBox x:Name="UserPasswordBox"
                                         PasswordChanged="UserPasswordBox_PasswordChanged"
                                         Margin="0,0,0,8"/>
                        </StackPanel>

                        <!-- Windows Auth Notice -->
                        <Border Background="{StaticResource WindowBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,16,0,0"
                                Visibility="{Binding IsWindowsAuth, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🔒 Using Active Directory (Integrated Security)"
                                       Foreground="#10B981"
                                       HorizontalAlignment="Center"
                                       FontWeight="Medium"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>