<UserControl x:Class="AutoReportWizard.Views.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AutoReportWizard.Models"
             Background="Transparent">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Displays validation message as a tooltip -->
        <Style TargetType="TextBox">
            <Setter Property="ToolTip"
                    Value="{Binding RelativeSource={RelativeSource Self},
                                    Path=(Validation.Errors)[0].ErrorContent}" />

            <Style.Triggers>
                <Trigger Property="Validation.HasError"
                         Value="True">
                    <Setter Property="BorderBrush"
                            Value="IndianRed"/>
                    <Setter Property="BorderThickness"
                            Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="32">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        MaxWidth="650">

                <TextBlock Text="Target Environment"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Select the environment where your report will be generated."
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32"/>

                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="24">

                    <StackPanel>

                        <!-- SQL Server -->

                        <TextBlock Text="SQL SERVER INSTANCE"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>

                        <TextBox
                            AutomationProperties.Name="SQL Server Instance"
                            Margin="0,0,0,24"
                            Text="{Binding ServerName,
                                           UpdateSourceTrigger=PropertyChanged,
                                           ValidatesOnNotifyDataErrors=True,
                                           NotifyOnValidationError=True}" />

                        <!-- Authentication -->

                        <TextBlock Text="AUTHENTICATION POLICY"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>

                        <ComboBox
                            AutomationProperties.Name="Authentication Type"
                            SelectedValue="{Binding AuthType}"
                            SelectedValuePath="Tag"
                            Margin="0,0,0,12">

                            <ComboBoxItem
                                Content="Windows Authentication"
                                Tag="{x:Static models:AuthenticationType.Windows}"/>

                            <ComboBoxItem
                                Content="SQL Server Authentication"
                                Tag="{x:Static models:AuthenticationType.SqlServer}"/>

                        </ComboBox>

                        <!-- SQL Authentication Fields -->

                        <StackPanel
                            Margin="0,12,0,0"
                            Visibility="{Binding IsSqlAuth,
                                                 Converter={StaticResource BoolToVis}}">

                            <TextBlock Text="USERNAME"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,8"/>

                            <TextBox
                                AutomationProperties.Name="SQL Username"
                                Margin="0,0,0,24"
                                Text="{Binding Username,
                                               UpdateSourceTrigger=PropertyChanged,
                                               ValidatesOnNotifyDataErrors=True,
                                               NotifyOnValidationError=True}" />

                            <TextBlock Text="PASSWORD"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,8"/>

                            <PasswordBox
                                x:Name="UserPasswordBox"
                                AutomationProperties.Name="SQL Password"
                                PasswordChanged="UserPasswordBox_PasswordChanged"
                                Margin="0,0,0,8"/>

                        </StackPanel>

                        <!-- Windows Authentication Notice -->

                        <Border
                            Background="{StaticResource WindowBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,16,0,0"
                            Visibility="{Binding IsWindowsAuth,
                                                 Converter={StaticResource BoolToVis}}">

                            <TextBlock
                                Text="🔒 Using Active Directory (Integrated Security)"
                                HorizontalAlignment="Center"
                                Foreground="#10B981"
                                FontWeight="SemiBold"/>

                        </Border>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>