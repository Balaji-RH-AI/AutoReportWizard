<UserControl x:Class="AutoReportWizard.Views.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoReportWizard"
             xmlns:models="clr-namespace:AutoReportWizard.Models"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="450"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,10">
            <TextBlock Text="Target Environment"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Select the environment where your report will be generated."
                       Foreground="Gray"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,24"/>

            <TextBlock Text="SQL Server Instance"
                       Foreground="#D4AF37"
                       Margin="0,0,0,5"
                       FontWeight="SemiBold"/>
            <TextBox x:Name="ServerTextBox"
                     Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                     Background="#1A1A1A"
                     Foreground="White"
                     BorderBrush="#444"
                     Padding="10"
                     Margin="0,0,0,16"
                     FontSize="14"/>

            <TextBlock Text="Authentication Policy"
                       Foreground="#D4AF37"
                       Margin="0,0,0,5"
                       FontWeight="SemiBold"/>
            <ComboBox SelectedValue="{Binding AuthType}"
                      SelectedValuePath="Tag"
                      Background="#1A1A1A"
                      Foreground="White"
                      BorderBrush="#444"
                      Padding="8"
                      Margin="0,0,0,20"
                      FontSize="13">
                <ComboBoxItem Content="Windows Authentication"
                              Tag="{x:Static models:AuthenticationType.Windows}"/>
                <ComboBoxItem Content="SQL Server Authentication"
                              Tag="{x:Static models:AuthenticationType.SqlServer}"/>
            </ComboBox>

            <StackPanel Visibility="{Binding IsSqlAuth, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Username"
                           Foreground="#D4AF37"
                           Margin="0,0,0,5"
                           FontWeight="SemiBold"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Background="#1A1A1A"
                         Foreground="White"
                         BorderBrush="#444"
                         Padding="10"
                         Margin="0,0,0,16"
                         FontSize="14"/>

                <TextBlock Text="Password"
                           Foreground="#D4AF37"
                           Margin="0,0,0,5"
                           FontWeight="SemiBold"/>
                <PasswordBox x:Name="UserPasswordBox"
                             PasswordChanged="UserPasswordBox_PasswordChanged"
                             Background="#1A1A1A"
                             Foreground="White"
                             BorderBrush="#444"
                             Padding="10"
                             Margin="0,0,0,16"
                             FontSize="14"/>
            </StackPanel>

            <Border Background="#0A0A0A"
                    BorderBrush="#006400"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,4,0,0"
                    Visibility="{Binding IsWindowsAuth, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="🔒 Using Active Directory (Integrated Security)"
                           Foreground="#90EE90"
                           HorizontalAlignment="Center"
                           FontWeight="Medium"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>