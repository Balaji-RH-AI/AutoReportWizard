<UserControl x:Class="AutoReportWizard.Views.DesignerFieldItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="12"
            x:Name="FieldBorder">
        <Border.RenderTransform>
            <TranslateTransform x:Name="LiftTransform" Y="0"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="FieldShadow" Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="LiftTransform"
                                         Storyboard.TargetProperty="Y"
                                         To="-2"
                                         Duration="0:0:0.15">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="FieldShadow"
                                         Storyboard.TargetProperty="ShadowDepth"
                                         To="6"
                                         Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="FieldShadow"
                                         Storyboard.TargetProperty="Opacity"
                                         To="0.5"
                                         Duration="0:0:0.15"/>
                        <ColorAnimation Storyboard.TargetName="FieldBorder"
                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                        To="#7C3AED"
                                        Duration="0:0:0.15"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Border.MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="LiftTransform"
                                         Storyboard.TargetProperty="Y"
                                         To="0"
                                         Duration="0:0:0.15">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="FieldShadow"
                                         Storyboard.TargetProperty="ShadowDepth"
                                         To="2"
                                         Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="FieldShadow"
                                         Storyboard.TargetProperty="Opacity"
                                         To="0.3"
                                         Duration="0:0:0.15"/>
                        <ColorAnimation Storyboard.TargetName="FieldBorder"
                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                        To="#334155"
                                        Duration="0:0:0.15"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Grid>
            <!-- Drag Surface -->
            <Thumb DragDelta="MoveThumb_DragDelta"
                    Opacity="0"
                    Cursor="SizeAll"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="{Binding DisplayHeaderLabel}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="{Binding FontWeight}"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                
                <!-- Data Type Badge -->
                <Border Background="{StaticResource AccentGradient}"
                        CornerRadius="6"
                        Padding="6,2"
                        Margin="8,0,0,0"
                        Opacity="0.15"
                        Visibility="{Binding HasDataType, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding DataType}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Resize Handle -->
            <Thumb Width="12"
                    Height="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Cursor="SizeNWSE"
                    DragDelta="ResizeThumb_DragDelta"
                    Margin="0,0,2,2">
                <Thumb.Template>
                    <ControlTemplate>
                        <Border Background="{StaticResource AccentGradient}"
                                CornerRadius="3"
                                Margin="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#7C3AED" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>