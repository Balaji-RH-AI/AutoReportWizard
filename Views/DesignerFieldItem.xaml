<UserControl x:Class="AutoReportWizard.Views.DesignerFieldItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#222"
            BorderBrush="{Binding BorderColor}"
            BorderThickness="1"
            CornerRadius="2">
        <Grid>
            <!-- Drag Surface -->
            <Thumb DragDelta="MoveThumb_DragDelta"
                    Opacity="0"
                    Cursor="SizeAll"/>

            <TextBlock Text="{Binding DisplayHeaderLabel}"
                    Foreground="White"
                       FontWeight="{Binding FontWeight}"
                    HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                    IsHitTestVisible="False"/>

            <!-- Resize Handle -->
            <Thumb Width="10"
                    Height="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                    DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate>
                        <Border Background="#D4AF37"
                                CornerRadius="5"
                                Margin="2"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>